@page "/"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@inject IPublicModuleService ModuleService

<PageTitle>NOOSE · National Office of Security Enforcement</PageTitle>

<MudPaper Elevation="4" Class="pa-8">
    <MudStack Spacing="5">
        <MudStack Spacing="2">
            <MudText Typo="Typo.overline" Color="Color.Primary">National Office of Security Enforcement</MudText>
            <MudText Typo="Typo.h3" Style="font-weight:700;line-height:1.15;">Defending Our Nation. Securing the Future.</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary" Style="max-width:640px;">
                Das NOOSE bündelt die staatliche Gefahrenabwehr und Aufklärung an einer Stelle. Diese Seite ist der
                öffentliche Zugang zur Behörde – mit Informationen für Interessierte und Bewerber. Der interne
                Aktenbestand bleibt den Agenten vorbehalten.
            </MudText>
        </MudStack>

        <MudDivider />

        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Stretch">
            @if (_careersEnabled)
            {
                <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                    <MudStack Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.WorkOutline" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">Karriere beim NOOSE</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Du möchtest Teil der Behörde werden? Informiere dich über das Auswahlverfahren und reiche deine
                            Bewerbung vertraulich über das Portal ein.
                        </MudText>
                        <MudButton Href="/karriere" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ArrowForward" Class="mt-2">Zur Karriere-Seite</MudButton>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Bürgerkonto</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Melde dich mit Discord an und gib Vor- und Nachnamen an, um Hinweise zu übermitteln und
                        ihren Stand zu verfolgen.
                    </MudText>
                    <AuthorizeView>
                        <Authorized Context="citizenCtx">
                            @* open to every account: an agent, partner or applicant has a civilian identity too *@
                            <MudButton Href="/buerger" Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Person" Class="mt-2">Zum Bürgerbereich</MudButton>
                        </Authorized>
                        <NotAuthorized>
                            @if (_registrationEnabled)
                            {
                                <form method="post" action="/Account/PerformExternalLogin" class="mt-2">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="/buerger" />
                                    <input type="hidden" name="source" value="buerger" />
                                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Login">Mit Discord anmelden</MudButton>
                                </form>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@_registrationOfflineText</MudText>
                            }
                        </NotAuthorized>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>

            <MudPaper Outlined="true" Class="pa-5" Style="flex:1 1 280px;">
                <MudStack Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">Agent-Zugang</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        NOOSE-Agenten gelangen über den internen Login zum Lagezentrum und zur Akten-Datenbank.
                    </MudText>
                    <AuthorizeView>
                        <Authorized Context="agentCtx">
                            @if (agentCtx.User.IsApplicant())
                            {
                                <MudButton Href="/portal" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Badge" Class="mt-2">Zum Bewerber-Portal</MudButton>
                            }
                            else if (agentCtx.User.IsCitizen())
                            {
                                @* a citizen has no agency access at all; the tile above is their way in *@
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true" Class="mt-2">Kein Zugriff</MudButton>
                            }
                            else
                            {
                                <MudButton Href="/dashboard" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Login" Class="mt-2">Zum Agent-Portal</MudButton>
                            }
                        </Authorized>
                        <NotAuthorized>
                            @* secret agency: no usable agent login on the public page *@
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true" Class="mt-2">Kein Zugriff</MudButton>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private bool _careersEnabled;
    private bool _registrationEnabled;
    private string _registrationOfflineText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapshot = await ModuleService.GetAsync();
            _careersEnabled = snapshot.IsEnabled(PublicModules.Careers);
            _registrationEnabled = snapshot.IsEnabled(PublicModules.CitizenRegistration);
            // an existing citizen keeps their access, so only the sign-up path reads the switch
            _registrationOfflineText = snapshot.Find(PublicModules.CitizenRegistration)?.OfflineText
                ?? "Neue Bürgerkonten können derzeit nicht angelegt werden.";
        }
        catch
        {
            /* best effort */
            _registrationOfflineText = "Neue Bürgerkonten können derzeit nicht angelegt werden.";
        }
    }
}
