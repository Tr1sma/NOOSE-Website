@page "/info/{Slug}"
@layout PublicSiteLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using NOOSE_Website.Models.Public
@inject IPublicPageService Pages
@inject IPublicFaqService Faq

<PageTitle>@(_page?.Title ?? "Information") · NOOSE</PageTitle>

@* hoisted out of the module gate: with the module off (the shipped default) the gate renders instead of the
   miss branch, and every invented slug would answer 200 without this tag *@
@if (_page is null)
{
    <HeadContent>
        <meta name="robots" content="noindex, nofollow" />
    </HeadContent>
}

@* The draft preview sits OUTSIDE the gate: PublicPageService.GetPreviewAsync is deliberately not module-gated,
   because preparing content while the module is still off is the point of a draft. Keyed on IsDraft rather than on
   Preview, so published content can never escape the gate - and a draft only ever comes back from GetPreviewAsync,
   whose first statement is Permission.RequireClassifiedRead. *@
@if (_page is { IsDraft: true })
{
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    <MudStack Spacing="4">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true">
            Vorschau des Entwurfs — dieser Stand ist öffentlich nicht sichtbar.
        </MudAlert>
        <MudText Typo="Typo.h4">@_page.Title</MudText>
        <MudDivider />
        @* raw markup, not RichHtml: that component resolves @{Typ:GUID} mentions and would print internal record names outside *@
        <div class="dokument-html">@((MarkupString)_page.Html)</div>
        @if (IsFaq)
        {
            <PublicFaqAccordion Snapshot="_faq" Open="@OpenQuestion" />
        }
        <div>
            <MudButton Href="/info" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ArrowBack">Zur Übersicht</MudButton>
        </div>
    </MudStack>
</MudPaper>
}
else
{
<PublicModuleGate Module="@PublicModules.InfoPages" Title="Information">
<MudPaper Elevation="4" Class="pa-4 pa-sm-8">
    @if (_page is null)
    {
        <MudStack Spacing="3" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.h6">Seite nicht gefunden</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Diese Informationsseite ist nicht veröffentlicht oder wurde zurückgezogen.
            </MudText>
            <MudButton Href="/info" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.MenuBook">Zur Übersicht</MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@_page.Title</MudText>
            <MudDivider />
            @* raw markup, not RichHtml: that component resolves @@{Typ:GUID} mentions and would print internal record names outside *@
            <div class="dokument-html">@((MarkupString)_page.Html)</div>
            @if (IsFaq)
            {
                <PublicFaqAccordion Snapshot="_faq" Open="@OpenQuestion" />
            }
            @if (_page.PublishedAt is { } published)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Stand: @published.ToLocalTime().ToString("dd.MM.yyyy")
                </MudText>
            }
            <div>
                <MudButton Href="/info" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ArrowBack">Zur Übersicht</MudButton>
            </div>
        </MudStack>
    }
</MudPaper>
</PublicModuleGate>
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    /// <summary>Agent-side preview of the draft; falls back to the published copy for everyone else.</summary>
    /// <remarks>
    /// Bound as a string on purpose: Blazor answers a value it cannot parse into a <c>bool</c> with a 500, and this
    /// route is reachable by anyone who can type a query string.
    /// </remarks>
    [SupplyParameterFromQuery(Name = "vorschau")]
    public string? PreviewFlag { get; set; }

    /// <summary>Anchor of the FAQ question to render expanded.</summary>
    /// <remarks>
    /// The page renders statically, so a fragment - which never reaches the server - could not open a closed
    /// section. The search hit therefore carries both: this query part for the server, the fragment for the
    /// browser to scroll with. Bound as a string and only ever compared, never written back into the page.
    /// </remarks>
    [SupplyParameterFromQuery(Name = PublicFaq.OpenParameter)]
    public string? OpenQuestion { get; set; }

    private bool Preview => PreviewFlag is "1" or "true" or "ja";

    private bool IsFaq => string.Equals(Slug, PublicFaq.PageSlug, StringComparison.OrdinalIgnoreCase);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private PublicPageView? _page;
    private PublicFaqSnapshot _faq = PublicFaqSnapshot.Empty;
    private string? _loadedKey;

    // navigating from one slug to another stays on this route template, so Blazor reuses the instance and
    // OnInitializedAsync would not run again
    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Slug}|{Preview}";
        if (_loadedKey == key)
        {
            return;
        }
        _loadedKey = key;
        _page = await LoadAsync();
        _faq = IsFaq ? await LoadFaqAsync() : PublicFaqSnapshot.Empty;
    }

    private async Task<PublicFaqSnapshot> LoadFaqAsync()
    {
        // the preview shows what is switched off as well, marked; without it there is no way to look at a
        // question before making it visible
        if (Preview && _page is { IsDraft: true } && AuthStateTask is not null)
        {
            try
            {
                return await Faq.GetPreviewAsync((await AuthStateTask).User);
            }
            catch (UnauthorizedAccessException)
            {
                // an anonymous visitor appending ?vorschau=1 simply gets the published sections
            }
            catch
            {
                /* best effort */
            }
        }

        try
        {
            return await Faq.GetPublishedAsync();
        }
        catch
        {
            /* best effort */
            return PublicFaqSnapshot.Empty;
        }
    }

    private async Task<PublicPageView?> LoadAsync()
    {
        if (Preview && AuthStateTask is not null)
        {
            try
            {
                var user = (await AuthStateTask).User;
                return await Pages.GetPreviewAsync(Slug, user);
            }
            catch (UnauthorizedAccessException)
            {
                // an anonymous visitor appending ?vorschau=1 simply gets the published page
            }
            catch
            {
                /* best effort */
            }
        }

        try
        {
            return await Pages.GetAsync(Slug);
        }
        catch
        {
            /* best effort */
            return null;
        }
    }
}
