@page "/bestenliste"
@using NOOSE_Website.Models.Enums
@using NOOSE_Website.Models.Gamification
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IGamificationService Gamification
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Bestenliste · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.EmojiEvents"
            Title="Bestenliste"
            Subtitle="Team-Ranking nach dokumentierter Ermittlungsarbeit." />

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudSelect T="GamificationPeriod" Value="_period" ValueChanged="OnPeriodChanged" Label="Zeitraum"
               Dense="true" Style="max-width:220px;">
        @foreach (var p in Enum.GetValues<GamificationPeriod>())
        {
            <MudSelectItem T="GamificationPeriod" Value="@p">@GamificationPeriodDisplay.Name(p)</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.EmojiEvents" Title="Noch keine Wertung"
                Text="In diesem Zeitraum wurde noch keine zählbare Ermittlungsarbeit erfasst." />
}
else
{
    <MudPaper Elevation="1">
        <MudTable Items="_rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Style="width:3rem;">#</MudTh>
                <MudTh>Agent</MudTh>
                <MudTh Style="text-align:right;">Punkte</MudTh>
                <MudTh Style="text-align:right;">Akten</MudTh>
                <MudTh Style="text-align:right;">Doks</MudTh>
                <MudTh Style="text-align:right;">Verkn.</MudTh>
                <MudTh Style="text-align:right;">Einstuf.</MudTh>
                <MudTh Style="text-align:right;">Beob.</MudTh>
                <MudTh Style="text-align:right;">Gelöst</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">@RankBadge(context.Position)</MudTd>
                <MudTd DataLabel="Agent"><MudLink Href="@($"/personal/{context.AgentId}")">@context.Codename</MudLink></MudTd>
                <MudTd DataLabel="Punkte" Style="text-align:right;"><b>@context.Points</b></MudTd>
                <MudTd DataLabel="Akten" Style="text-align:right;">@context.Records</MudTd>
                <MudTd DataLabel="Doks" Style="text-align:right;">@context.Docs</MudTd>
                <MudTd DataLabel="Verkn." Style="text-align:right;">@context.Links</MudTd>
                <MudTd DataLabel="Einstuf." Style="text-align:right;">@context.Classifications</MudTd>
                <MudTd DataLabel="Beob." Style="text-align:right;">@context.Observations</MudTd>
                <MudTd DataLabel="Gelöst" Style="text-align:right;">@context.SolvedCases</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private bool _load = true;
    private GamificationPeriod _period = GamificationPeriod.AllTime;
    private IReadOnlyList<LeaderboardEntry> _rows = Array.Empty<LeaderboardEntry>();

    protected override async Task OnInitializedAsync()
    {
        _period = QueryState.ReadEnum<GamificationPeriod>(Nav, "zeitraum") ?? GamificationPeriod.AllTime;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _rows = await Gamification.GetLeaderboardAsync(_period);
        _load = false;
    }

    private async Task OnPeriodChanged(GamificationPeriod period)
    {
        _period = period;
        await QueryState.WriteAsync(JS, Nav, ("zeitraum", period == GamificationPeriod.AllTime ? null : period.ToString()));
        await LoadAsync();
    }

    private static string RankBadge(int position) => position switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        _ => position.ToString(),
    };
}
