@page "/bewerbungen"
@attribute [Authorize(Policy = Policies.HrbOrLeadership)]

<PageTitle>Bewerbungen · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.HowToReg"
            Title="Bewerbungen"
            Subtitle="Eingang, Sperren, Anschreiben-Vorlagen und Eignungstests." />

<RecordSectionRail>
    <RecordSection Group="Verfahren" Slug="eingang" Label="Eingang" Icon="@Icons.Material.Filled.Inbox">
        <BewerbungenPanel />
    </RecordSection>
    <RecordSection Group="Verfahren" Slug="sperren" Label="Sperren" Icon="@Icons.Material.Filled.Block">
        <SperrenPanel />
    </RecordSection>

    <RecordSection Group="Material" Slug="vorlagen" Label="Anschreiben-Vorlagen" Icon="@Icons.Material.Filled.MarkEmailRead">
        <VorlagenPanel />
    </RecordSection>
    <RecordSection Group="Material" Slug="tests" Label="Eignungstests" Icon="@Icons.Material.Filled.Quiz">
        <TestsPanel />
    </RecordSection>

    <RecordSection Group="Konfiguration" Slug="automatik" Label="Automatik" Icon="@Icons.Material.Filled.AutoMode">
        <AutomatikPanel />
    </RecordSection>
</RecordSectionRail>
