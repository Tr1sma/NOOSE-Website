@implements IDisposable
@inject IBewerbungTestService TestService
@inject BewerbungBroadcaster Broadcaster
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Elevation="2" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-2">Eignungstest</MudText>

    @if (_first)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_assignment is null)
    {
        @if (_canWrite)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudSelect T="string" @bind-Value="_selectedTestId" Label="Test auswählen" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Style="min-width:240px;">
                    @foreach (var t in _tests)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Title@(t.TimeLimitMinutes is int m ? $" · {m} Min" : "")</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AssignmentInd"
                           OnClick="AssignAsync" Disabled="@string.IsNullOrEmpty(_selectedTestId)">Zuweisen</MudButton>
            </MudStack>
            @if (_tests.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                    Noch keine aktiven Tests vorhanden. Lege unter „Bewerbungs-Tests“ einen Test an.
                </MudText>
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Kein Test zugewiesen.</MudText>
        }
    }
    else if (_assignment.CompletedAt is null)
    {
        @if (_assignment.StartedAt is null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Test wurde zugewiesen und wartet auf die Beantwortung durch den Bewerber.
            </MudAlert>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">@Zeitbudget</MudText>
        }
        else if (!Ueberfaellig)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Der Bewerber bearbeitet den Test seit
                @_assignment.StartedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@Restzeittext@Zusatztext
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                Zeit abgelaufen. Die Abgabe wird gerade abgeschlossen; die Auswertung erscheint in Kürze.
            </MudAlert>
        }
    }
    else if (_eval is not null)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mb-2">
            <MudText Typo="Typo.subtitle2">
                @_eval.Title · abgeschlossen am @_assignment.CompletedAt!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
            </MudText>
            @if (_assignment.TimedOut)
            {
                @* Warning, never Error: Error is already the failed-verdict colour two chips along *@
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                         Icon="@Icons.Material.Filled.TimerOff">Zeit abgelaufen</MudChip>
            }
            @if (Bearbeitungsdauer is { Length: > 0 } dauer)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Timer">@dauer</MudChip>
            }
            @if (_assignment.AttemptCount > 1)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    @_assignment.AttemptCount. Versuch
                </MudChip>
            }
            <MudSpacer />
            @if (_eval.GradedAt is null && _eval.OpenCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                    @(_eval.Items.Count - _eval.OpenCount) von @_eval.Items.Count korrigiert
                </MudChip>
            }
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @_eval.TotalPoints / @_eval.MaxPoints Punkte (@_eval.Percent %)
            </MudChip>
            @if (_eval.Passed is true)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Bestanden (≥@_eval.PassPercent %)</MudChip>
            }
            else if (_eval.Passed is false)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Nicht bestanden (≥@_eval.PassPercent %)</MudChip>
            }
        </MudStack>

        @if (_assignment.TimedOut)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                Die Bearbeitungszeit war abgelaufen. Abgegeben wurde automatisch, was der Bewerber bis dahin
                eingetragen hatte — leere Antworten sind hier nicht zwingend Wissenslücken.
            </MudAlert>
        }

        @if (_eval.GradedAt is not null)
        {
            @* once the grading is closed the single questions are noise; the result is the statement *@
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                Korrektur abgeschlossen am @_eval.GradedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@(string.IsNullOrWhiteSpace(_eval.GradedByName) ? "" : " von " + _eval.GradedByName).
            </MudAlert>
            @if (_canWrite)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.LockOpen" OnClick="ReopenAsync" Disabled="_busy">
                    Korrektur wieder öffnen
                </MudButton>
            }
        }
        else
        {
        <MudStack Spacing="2">
            @foreach (var (item, i) in _eval.Items.Select((x, i) => (x, i + 1)))
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.body2"><b>@i. @item.Prompt</b></MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@item.AwardedPoints / @item.Points P.</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
                        @if (item.EffectiveCorrect is true)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else if (item.EffectiveCorrect is false)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Default" Size="Size.Small" />
                        }
                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(item.AnswerText) ? "— keine Antwort —" : item.AnswerText)</MudText>
                        @if (item.ManualCorrect is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">manuell</MudChip>
                        }
                    </MudStack>

                    @if (item.EffectiveCorrect is not true && !string.IsNullOrWhiteSpace(item.CorrectAnswer))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Richtig: @item.CorrectAnswer</MudText>
                    }

                    @if (item.Type == TestQuestionType.FreeText && (item.MatchedKeywords.Count > 0 || item.MissedKeywords.Count > 0))
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                            @foreach (var k in item.MatchedKeywords)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Check">@k</MudChip>
                            }
                            @foreach (var k in item.MissedKeywords)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Close">@k</MudChip>
                            }
                        </MudStack>
                    }

                    @if (_canWrite)
                    {
                        @* keyed on the question, so a question added after the submission is gradeable too *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                            <MudNumericField T="int?" Value="@item.ManualPoints"
                                             ValueChanged="@(v => SetPointsAsync(item.QuestionId, v))"
                                             Label="Punkte" Min="0" Max="@item.Points" Clearable="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Style="max-width:130px;" Disabled="_busy" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">von @item.Points</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.AutoFixHigh" Disabled="_busy"
                                       OnClick="@(() => SetPointsAsync(item.QuestionId, null))">Auto</MudButton>
                            @if (!item.IsGraded)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    noch offen
                                </MudChip>
                            }
                        </MudStack>
                    }
                </MudPaper>
            }
        </MudStack>

        @if (_canWrite)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.TaskAlt" OnClick="CompleteAsync"
                           Disabled="@(_busy || _eval.OpenCount > 0)">
                    Als korrigiert markieren
                </MudButton>
                @if (_eval.OpenCount > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Noch @_eval.OpenCount Frage(n) ohne Wertung.
                    </MudText>
                }
            </MudStack>
        }
        }
    }

    @if (_assignment is not null && _canWrite)
    {
        <MudDivider Class="my-3" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            @if (_assignment.GradedAt is null && Verlaengerbar)
            {
                @* additive and in the applicant's favour, so no confirmation; fixed steps beat a free field
                   that invites a typo'd 100 *@
                <MudMenu Label="Zeit verlängern" Icon="@Icons.Material.Filled.MoreTime" Dense="true"
                         Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy">
                    <MudMenuItem OnClick="@(() => ExtendAsync(5))">+ 5 Minuten</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExtendAsync(10))">+ 10 Minuten</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExtendAsync(15))">+ 15 Minuten</MudMenuItem>
                    <MudMenuItem OnClick="@(() => ExtendAsync(30))">+ 30 Minuten</MudMenuItem>
                </MudMenu>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAsync"
                       Disabled="@(_busy || _assignment.GradedAt is not null)">
                Test neu freigeben
            </MudButton>
            @if (_assignment.GradedAt is not null)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Korrektur zuerst wieder öffnen.</MudText>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string BewerbungId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    private bool _first = true;
    private bool _busy;
    private bool _canWrite;
    private string? _selectedTestId;
    private List<BewerbungTest> _tests = new();
    private BewerbungTestAssignment? _assignment;
    private int? _testMinutes;
    private TestEvaluation? _eval;

    protected override async Task OnInitializedAsync()
    {
        _canWrite = User.MayWrite();
        Broadcaster.Modified += OnModified;
        await LoadAsync();
    }

    // no spinner on a refresh: swapping the list for a progress bar collapsed the page height, and the browser
    // scrolled back to the top on every grading click
    private async Task LoadAsync()
    {
        _assignment = await TestService.GetAssignmentAsync(BewerbungId, User);
        // dropped first: an extension reopens the attempt, and a stale report would keep rendering
        _eval = null;
        // always loaded: before the start the minutes still live on the test, not on the assignment
        var all = await TestService.GetTestsAsync(User);
        _tests = all.Where(x => x.IsActive).ToList();
        _testMinutes = _assignment is null
            ? null
            : all.FirstOrDefault(x => x.Id == _assignment.TestId)?.TimeLimitMinutes;
        if (_assignment is { CompletedAt: not null })
        {
            _eval = await TestService.GetEvaluationAsync(BewerbungId, User);
        }
        _first = false;
    }

    private async Task AssignAsync()
    {
        if (string.IsNullOrEmpty(_selectedTestId))
        {
            return;
        }
        try
        {
            await TestService.AssignAsync(BewerbungId, _selectedTestId, User);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // no LoadAsync here: the service broadcasts and OnModified reloads once. Doing both doubled the queries and
    // widened the race that made the panel flicker.
    private Task SetPointsAsync(string questionId, int? points)
        => RunAsync(() => TestService.SetAwardedPointsAsync(_assignment!.Id, questionId, points, User));

    private Task CompleteAsync() => RunAsync(() => TestService.CompleteGradingAsync(BewerbungId, User));

    private Task ReopenAsync() => RunAsync(() => TestService.ReopenGradingAsync(BewerbungId, User));

    private Task ExtendAsync(int minutes) => RunAsync(async () =>
    {
        await TestService.ExtendAttemptAsync(BewerbungId, minutes, User);
        Snackbar.Add($"Bearbeitungszeit um {minutes} Minuten verlängert.", Severity.Success);
    });

    private async Task ResetAsync()
    {
        // destructive but scoped and repeatable, so a mandatory reason rather than a type-the-name dialog:
        // it produces a useful audit line instead of pure friction
        var reason = await ReasonDialog.ShowAsync(DialogService, "Test neu freigeben?",
            "Die bisherigen Antworten und der Zwischenstand dieses Bewerbers werden verworfen. Der Test gilt "
            + "wieder als nicht begonnen; die Bearbeitungszeit startet erneut, sobald der Bewerber ihn startet. "
            + "Eine bereits erfolgte Korrektur wird verworfen.",
            confirmText: "Neu freigeben", label: "Begründung", mandatoryReason: true, colour: Color.Warning);
        if (reason is null)
        {
            return;
        }
        await RunAsync(() => TestService.ResetAttemptAsync(BewerbungId, null, reason, User));
    }

    /// <summary>Time can be granted while the attempt is open, and as a rescue once the clock closed it.</summary>
    /// <remarks>Never after a hand-in that beat the clock: that attempt is finished, and reopening it would
    /// let the applicant edit answers they already submitted.</remarks>
    private bool Verlaengerbar => _assignment is not null
        && TestDeadline.AllowedMinutes(_assignment, _testMinutes) is not null
        && _assignment is not { CompletedAt: not null, TimedOut: false };

    /// <summary>Derived from the deadline, not only from the flag: it can pass while the applicant is offline.</summary>
    private bool Ueberfaellig => _assignment is { CompletedAt: null }
        && TestDeadline.IsExpired(_assignment.DeadlineAt, DateTime.UtcNow);

    private string Zeitbudget
    {
        get
        {
            var minutes = _assignment is null ? null : TestDeadline.AllowedMinutes(_assignment, _testMinutes);
            if (minutes is null)
            {
                return "Bearbeitungszeit: unbegrenzt.";
            }
            var extra = _assignment!.ExtraMinutes > 0 ? $" Verlängert um {_assignment.ExtraMinutes} Min." : "";
            return $"Bearbeitungszeit: {minutes} Minuten. Die Uhr startet, sobald der Bewerber den Test startet.{extra}";
        }
    }

    /// <summary>"ca." on purpose: the panel reloads on a broadcast, not on a ticker.</summary>
    private string Restzeittext => TestAttemptLogic.RemainingMinutes(_assignment?.DeadlineAt, DateTime.UtcNow) is { } left
        ? $" · Restzeit ca. {left} Min"
        : _assignment?.DeadlineAt is null ? " (ohne Bearbeitungszeit)" : string.Empty;

    private string Zusatztext => _assignment is { ExtraMinutes: > 0 }
        ? $" · verlängert um {_assignment.ExtraMinutes} Min"
        : string.Empty;

    /// <summary>No data, no chip: an attempt assigned before the clock existed has no start.</summary>
    /// <remarks>The denominator is dropped once time was granted: after a rescue extension the span from the
    /// start to the hand-in also covers the hours the attempt sat expired, so the two are not comparable.</remarks>
    private string Bearbeitungsdauer
    {
        get
        {
            if (_assignment is null
                || TestDeadline.UsedMinutes(_assignment.StartedAt, _assignment.CompletedAt) is not { } used)
            {
                return string.Empty;
            }
            return _assignment.ExtraMinutes == 0 && TestDeadline.AllowedMinutes(_assignment) is { } allowed
                ? $"Bearbeitungsdauer: {used} von {allowed} Min"
                : $"Bearbeitungsdauer: {used} Min";
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnModified(string id)
    {
        if (id != BewerbungId)
        {
            return;
        }
        _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
