@page "/portal/test"
@layout ApplicantPortalLayout
@attribute [AllowAnonymous]
@inject IBewerbungTestService TestService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Eignungstest · NOOSE</PageTitle>

<style>
    /* Deterrent, not protection: the prompts are in the DOM either way. */
    .noose-pruefung {
        user-select: none;
        -webkit-user-select: none;
        position: relative;
        /* clips the rotated watermark layer to the questions */
        overflow: hidden;
    }
    /* The applicant must still be able to edit their own free-text answer. */
    .noose-pruefung input,
    .noose-pruefung textarea {
        user-select: text;
        -webkit-user-select: text;
    }
    .noose-pruefung-wasserzeichen {
        position: absolute;
        /* oversized so the rotated layer still covers every corner */
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        z-index: 3;
        pointer-events: none;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        justify-content: center;
        gap: 48px 64px;
        transform: rotate(-30deg);
        transform-origin: center;
        opacity: 0.08;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        white-space: nowrap;
        color: var(--mud-palette-text-primary);
    }
    /* Sibling of .noose-pruefung, never a child: that div is overflow:hidden, which breaks position:sticky. */
    .noose-pruefung-leiste {
        position: sticky;
        /* not 0: the portal shell has no app bar, and flush against the edge the bar reads as detached */
        top: 8px;
        /* above the watermark layer */
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 8px 12px;
        flex-wrap: wrap;
        padding: 8px 12px;
        /* opaque, or the questions scroll through it */
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        box-shadow: var(--mud-elevation-4);
    }
    .noose-nur-vorlesen {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        border: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .noose-restzeit-kritisch { animation: noose-restzeit-puls 1s ease-in-out infinite; }
    @@keyframes noose-restzeit-puls { 50% { opacity: 0.55; } }
    @@media (prefers-reduced-motion: reduce) {
        /* colour, fill and the mm:ss value carry the state; the pulse is redundancy */
        .noose-restzeit-kritisch { animation: none; }
    }
    .noose-pruefung-druckhinweis { display: none; }
    @@media print {
        .noose-pruefung { display: none !important; }
        .noose-pruefung-leiste { display: none !important; }
        .noose-pruefung-druckhinweis { display: block !important; }
    }
</style>

@if (_ready)
{
    <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
            }

            @if (Completed)
            {
                @if (TimedOut)
                {
                    @* Info, never Warning: running out of time is a neutral fact, and a louder colour would
                       read as a verdict the applicant is not allowed to learn *@
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                        Deine Bearbeitungszeit ist abgelaufen. Was du bis dahin eingetragen hattest, wurde
                        automatisch abgegeben. Wir melden uns.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                        Du hast diesen Test bereits abgeschlossen.
                    </MudAlert>
                }
                <MudButton Variant="Variant.Outlined" Href="/portal/status" StartIcon="@Icons.Material.Filled.ArrowBack">Zurück</MudButton>
            }
            else if (_test is null && _status is { StartedAt: null, TimeLimitMinutes: int limit })
            {
                @* the start gate: the clock starts with the click, not with a curious tap from the status page *@
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    Bearbeitungszeit: <b>@limit Minuten</b>. Die Uhr startet, sobald du auf „Test jetzt starten“
                    klickst, und läuft dann durchgehend weiter — auch wenn du das Fenster schließt. Bei Ablauf
                    wird automatisch abgegeben, was du bis dahin eingetragen hast.
                </MudAlert>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Text" Color="Color.Default" Href="/portal/status"
                               StartIcon="@Icons.Material.Filled.ArrowBack">Zurück zur Bewerbung</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="StartAsync" Disabled="_busy">Test jetzt starten</MudButton>
                </MudStack>
            }
            else if (_test is null)
            {
                @* not the start gate: a hand-in that did not go through, or the test was released again.
                   Offering to start would restate a state we do not actually know. *@
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" role="status">
                    Dieser Test steht gerade nicht zur Bearbeitung offen. Bitte lade die Seite neu oder sieh
                    in deiner Bewerbung nach.
                </MudAlert>
                <MudButton Variant="Variant.Outlined" Href="/portal/status" StartIcon="@Icons.Material.Filled.ArrowBack">Zurück</MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="noose-pruefung-druckhinweis">
                    Der Fragebogen wird nicht gedruckt. Bitte beantworte den Test online.
                </MudText>

                @* rendered without a deadline too: this bar owns the autosave, and an unlimited attempt must
                   not silently lose its answers on a reload *@
                <div class="noose-pruefung-leiste">
                    <PruefungStatusBar DeadlineAt="_test.DeadlineAt" Dirty="IsDirty" Save="SaveDraftAsync"
                                       OnExpired="OnExpiredAsync" OnFiveMinutes="OnFiveMinutes" />
                </div>

                <div id="@ContainerId" class="noose-pruefung"
                     @oncopy:preventDefault="true" @oncut:preventDefault="true"
                     @oncontextmenu:preventDefault="true" @ondragstart:preventDefault="true">
                <div class="noose-pruefung-wasserzeichen" aria-hidden="true">
                    @for (var i = 0; i < 40; i++)
                    {
                        <span>@Watermark</span>
                    }
                </div>
                @foreach (var (q, index) in _test.Questions.Select((q, i) => (q, i + 1)))
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            @index. @q.Prompt @(q.Required ? "*" : "")
                        </MudText>

                        @switch (q.Type)
                        {
                            case TestQuestionType.MultipleChoice:
                                if (q.AllowMultiple)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                                        Mehrere Antworten möglich.
                                    </MudText>
                                    foreach (var o in q.Options)
                                    {
                                        var optionId = o.OptionId;
                                        <MudCheckBox T="bool" Dense="true" Label="@o.Label" Disabled="_expiring"
                                                     Value="@Ticked(q.QuestionId).Contains(optionId)"
                                                     ValueChanged="@(v => Tick(q.QuestionId, optionId, v))" />
                                    }
                                }
                                else
                                {
                                    <MudRadioGroup T="string" Value="@_choice.GetValueOrDefault(q.QuestionId)"
                                                   ValueChanged="@(v => Set(_choice, q.QuestionId, v))">
                                        @foreach (var o in q.Options)
                                        {
                                            <MudRadio T="string" Value="@o.OptionId" Disabled="_expiring">@o.Label</MudRadio>
                                        }
                                    </MudRadioGroup>
                                }
                                break;

                            case TestQuestionType.YesNo:
                                <MudRadioGroup T="string" Value="@_text.GetValueOrDefault(q.QuestionId)"
                                               ValueChanged="@(v => Set(_text, q.QuestionId, v))">
                                    <MudRadio T="string" Value="@("Ja")" Disabled="_expiring">Ja</MudRadio>
                                    <MudRadio T="string" Value="@("Nein")" Disabled="_expiring">Nein</MudRadio>
                                </MudRadioGroup>
                                break;

                            default:
                                @* Immediate with a debounce, and the debounce is load-bearing: without Immediate
                                   the field only updates on blur, so text typed and never left would be lost at
                                   the deadline. Without the interval it would write on every keystroke. *@
                                <MudTextField T="string" Value="@_text.GetValueOrDefault(q.QuestionId)"
                                              ValueChanged="@(v => Set(_text, q.QuestionId, v))"
                                              Immediate="true" DebounceInterval="1500" Disabled="_expiring"
                                              Variant="Variant.Outlined" Lines="3" />
                                break;
                        }
                    </MudPaper>
                }
                </div>

                @if (_expiring)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" role="status">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        Die Zeit ist abgelaufen. Deine Antworten werden abgegeben …
                    </MudAlert>
                }

                @* a way back while the test is unfinished: the completed branch has one, this one had none, so a
                   half-answered test was a trap *@
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="LeaveAsync"
                               StartIcon="@Icons.Material.Filled.ArrowBack" Disabled="_expiring">Zurück zur Bewerbung</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                               OnClick="@(() => SubmitAsync(false))" Disabled="@(_busy || _expiring)">Test absenden</MudButton>
                </MudStack>
            }
        </MudStack>
    </MudPaper>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ClaimsPrincipal _user = default!;
    private bool _ready;
    private bool _busy;
    private bool _expiring;
    private bool _dirty;
    private TestStatusView? _status;
    private TestView? _test;
    private readonly Dictionary<string, string> _choice = new();
    private readonly Dictionary<string, HashSet<string>> _ticked = new();
    private readonly Dictionary<string, string> _text = new();

    private string Title => _test?.Title ?? _status?.Title ?? string.Empty;
    private string? Description => _test?.Description ?? _status?.Description;
    private bool Completed => _test?.Completed ?? _status?.Completed ?? false;
    private bool TimedOut => _test?.TimedOut ?? _status?.TimedOut ?? false;

    private bool IsDirty() => _dirty;

    private HashSet<string> Ticked(string questionId)
        => _ticked.TryGetValue(questionId, out var set) ? set : [];

    private void Set(Dictionary<string, string> target, string questionId, string value)
    {
        target[questionId] = value;
        _dirty = true;
    }

    private void Tick(string questionId, string optionId, bool on)
    {
        if (!_ticked.TryGetValue(questionId, out var set))
        {
            set = [];
            _ticked[questionId] = set;
        }
        if (on)
        {
            set.Add(optionId);
        }
        else
        {
            set.Remove(optionId);
        }
        _dirty = true;
    }

    private const string ContainerId = "noose-pruefung-bogen";
    private IJSObjectReference? _module;
    private bool _guarded;
    private bool _protectionTried;

    /// <summary>Traceability, not prevention: a leaked screenshot points back at one applicant.</summary>
    private string Watermark => _test is null
        ? string.Empty
        : $"{_test.CaseNumber} · {DateTime.Now:dd.MM.yyyy HH:mm}";

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        if (!_user.IsApplicant())
        {
            Nav.NavigateTo("/karriere", forceLoad: true);
            return;
        }
        // the summary first, because it starts nothing: only the questionnaire call stamps the clock
        _status = await TestService.GetTestStatusForApplicantAsync(_user);
        if (_status is null)
        {
            Nav.NavigateTo("/portal/status");
            return;
        }
        // an attempt already running is resumed, and one without a limit needs no gate at all
        if (!_status.Completed && (_status.StartedAt is not null || _status.TimeLimitMinutes is null))
        {
            await LoadTestAsync();
            if (_test is null)
            {
                // the test vanished under the assignment; the status page explains the state, this page cannot
                Nav.NavigateTo("/portal/status");
                return;
            }
        }
        _ready = true;
    }

    private async Task LoadTestAsync()
    {
        _test = await TestService.GetAssignedForApplicantAsync(_user);
        if (_test is null)
        {
            return;
        }
        _choice.Clear();
        _ticked.Clear();
        _text.Clear();
        foreach (var q in _test.Questions)
        {
            if (q.Type == TestQuestionType.MultipleChoice)
            {
                if (q.AllowMultiple)
                {
                    _ticked[q.QuestionId] = q.SavedOptionIds.ToHashSet(StringComparer.Ordinal);
                }
                else if (q.SavedOptionIds.FirstOrDefault() is { Length: > 0 } one)
                {
                    _choice[q.QuestionId] = one;
                }
            }
            else if (q.SavedFreeText is { Length: > 0 } saved)
            {
                _text[q.QuestionId] = saved;
            }
        }
        _dirty = false;
        _protectionTried = false;
    }

    private async Task StartAsync()
    {
        _busy = true;
        try
        {
            await LoadTestAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        _busy = false;
    }

    // a snackbar, not a banner: a banner would still claim "less than 5 minutes" after HRB granted more,
    // and the countdown chip turning amber and then red already carries the state
    private void OnFiveMinutes()
        => Snackbar.Add("Noch 5 Minuten. Danach wird automatisch abgegeben.", Severity.Warning);

    /// <summary>Flushes the draft; the status bar re-reads the deadline from the result.</summary>
    private async Task<TestDraftResult> SaveDraftAsync()
    {
        _dirty = false;
        TestDraftResult result;
        try
        {
            result = await TestService.SaveDraftAsync(_test!.AssignmentId, _test.AttemptNumber, Collect(), _user);
        }
        catch
        {
            // still unsaved, so the next flush must carry these edits again
            _dirty = true;
            throw;
        }
        if (result.Outcome == TestDraftOutcome.Closed)
        {
            await ReloadClosedAsync();
        }
        return result;
    }

    private async Task OnExpiredAsync()
    {
        if (_expiring)
        {
            return;
        }
        _expiring = true;
        StateHasChanged();
        // _test can already be gone: the flush at zero closes the attempt server-side and persists this
        // payload on the way. Nothing is lost then, so only the view has to catch up.
        if (_test is not null)
        {
            await SubmitAsync(auto: true);
        }
        await ReloadClosedAsync();
    }

    /// <summary>Saves before leaving, so the last edits are not lost to the ten-second cadence.</summary>
    private async Task LeaveAsync()
    {
        if (_test?.DeadlineAt is not null && _dirty)
        {
            try { await SaveDraftAsync(); } catch { /* best effort */ }
        }
        Nav.NavigateTo("/portal/status");
    }

    private List<TestAnswerInput> Collect()
    {
        var answers = new List<TestAnswerInput>();
        foreach (var q in _test!.Questions)
        {
            var input = new TestAnswerInput { QuestionId = q.QuestionId };
            if (q.Type == TestQuestionType.MultipleChoice)
            {
                input.SelectedOptionIds = q.AllowMultiple
                    ? Ticked(q.QuestionId).ToList()
                    : _choice.GetValueOrDefault(q.QuestionId) is { Length: > 0 } one ? [one] : [];
            }
            else
            {
                input.FreeText = _text.GetValueOrDefault(q.QuestionId);
            }
            answers.Add(input);
        }
        return answers;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // deliberately NOT gated on firstRender: behind the start gate the questionnaire first appears on a
        // later render, and gating on the first one left every timed test without its anti-copy guard
        if (_protectionTried || _module is not null || _test is null || _test.Completed)
        {
            return;
        }
        _protectionTried = true;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pruefung.js?v=2");
            await _module.InvokeVoidAsync("schuetzen", ContainerId);
            _guarded = true;
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch { /* best effort */ }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _guarded)
            {
                await _module.InvokeVoidAsync("freigeben", ContainerId);
            }
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { /* ignore */ }
        catch { /* ignore */ }
    }

    private async Task SubmitAsync(bool auto)
    {
        if (_test is null)
        {
            return;
        }
        if (!auto)
        {
            // the applicant's own safety net; the automatic hand-in must never be stopped by it
            foreach (var q in _test.Questions.Where(q => q.Required))
            {
                var answered = q.Type == TestQuestionType.MultipleChoice
                    ? (q.AllowMultiple ? Ticked(q.QuestionId).Count > 0 : _choice.ContainsKey(q.QuestionId))
                    : !string.IsNullOrWhiteSpace(_text.GetValueOrDefault(q.QuestionId));
                if (!answered)
                {
                    Snackbar.Add("Bitte beantworte alle Pflichtfragen.", Severity.Warning);
                    return;
                }
            }
        }

        _busy = true;
        try
        {
            var outcome = await TestService.SubmitAnswersAsync(_test.AssignmentId, _test.AttemptNumber, Collect(), _user);
            if (auto || outcome == TestSubmitOutcome.ClosedByTimeout)
            {
                // shown in place rather than by redirecting: after an involuntary hand-in the applicant needs
                // to read why the form vanished. The caller reloads.
                _busy = false;
                if (!auto)
                {
                    await ReloadClosedAsync();
                }
                return;
            }
            Snackbar.Add("Test übermittelt.", Severity.Success);
            Nav.NavigateTo("/portal/status");
        }
        catch (Exception ex)
        {
            if (!auto)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            _busy = false;
        }
    }

    /// <summary>Re-reads the attempt after the clock closed it, so the page shows the expiry screen.</summary>
    private async Task ReloadClosedAsync()
    {
        try
        {
            // kept when the read comes back empty: overwriting with null would drop the page into a branch
            // that knows nothing about the attempt
            _status = await TestService.GetTestStatusForApplicantAsync(_user) ?? _status;
            _test = null;
        }
        catch { /* best effort */ }
        _expiring = false;
        StateHasChanged();
    }
}
