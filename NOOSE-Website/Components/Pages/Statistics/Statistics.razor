@page "/statistik"

<PageTitle>Statistik &amp; Auswertungen · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.QueryStats"
            Title="Statistik &amp; Auswertungen"
            Subtitle="Aggregierte Zahlen über den Aktenbestand und die monatlichen Lageberichte." />

@* the report archive holds unfiltered aggregates, so it stays leadership-only *@
<RecordSectionRail>
    <RecordSection Slug="auswertung" Label="Auswertungen" Icon="@Icons.Material.Filled.QueryStats">
        <StatisticsPanel />
    </RecordSection>

    <AuthorizeView Policy="@Policies.LeadershipPage" Context="reportsSection">
        <RecordSection Slug="lageberichte" Label="Lageberichte" Icon="@Icons.Material.Filled.Assessment">
            <SituationReportsPanel />
        </RecordSection>
    </AuthorizeView>
</RecordSectionRail>
