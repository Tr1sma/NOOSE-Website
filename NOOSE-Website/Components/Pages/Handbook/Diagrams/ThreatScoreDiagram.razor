@* The 0-100 scale with its four bands, plus the floor each classification sets. *@

<svg viewBox="0 0 640 320" role="img" aria-labelledby="threatScoreTitle threatScoreDesc"
     style="width:100%;height:auto;max-width:640px;">
    <title id="threatScoreTitle">Der Bedrohungs-Score</title>
    <desc id="threatScoreDesc">
        Eine Skala von 0 bis 100 mit den Bändern niedrig, mittel, hoch und kritisch. Die Einstufung setzt
        einen Sockel: Prüffall 12, Verdachtsfall 50, gesichert staatsgefährdend 75.
    </desc>

    @{
        // 0-100 maps onto x = 40 .. 600
        var bands = new[]
        {
            (0, 25, "niedrig", "var(--mud-palette-success)"),
            (25, 50, "mittel", "var(--mud-palette-info)"),
            (50, 75, "hoch", "var(--mud-palette-warning)"),
            (75, 100, "kritisch", "var(--mud-palette-error)"),
        };
        var floors = new[] { (12, "Prüffall"), (50, "Verdachtsfall"), (75, "Gesichert staatsgefährdend") };
        Func<int, int> px = v => 40 + (v * 56 / 10);
    }

    <text x="16" y="26" font-size="12" fill="var(--mud-palette-text-secondary)">Gefährdungsstufe</text>

    @foreach (var (from, to, name, colour) in bands)
    {
        @* wrapped in a group: Razor claims a bare <text> inside a code block for its own use *@
        <g>
            <rect x="@px(from)" y="40" width="@(px(to) - px(from))" height="38" rx="4"
                  fill="@colour" opacity="0.28" stroke="@colour" />
            <text x="@((px(from) + px(to)) / 2)" y="64" font-size="11" text-anchor="middle"
                  fill="var(--mud-palette-text-primary)">@name</text>
        </g>
    }

    @foreach (var value in new[] { 0, 25, 50, 75, 100 })
    {
        <g>
            <line x1="@px(value)" y1="78" x2="@px(value)" y2="86"
                  stroke="var(--mud-palette-lines-default)" />
            <text x="@px(value)" y="100" font-size="10" text-anchor="middle"
                  fill="var(--mud-palette-text-secondary)">@value</text>
        </g>
    }

    <text x="16" y="134" font-size="12" fill="var(--mud-palette-text-secondary)">Sockel je Einstufung</text>

    @for (var i = 0; i < floors.Length; i++)
    {
        var (value, name) = floors[i];
        var y = 150 + (i * 34);
        <g>
            <line x1="40" y1="@(y + 12)" x2="600" y2="@(y + 12)"
                  stroke="var(--mud-palette-lines-default)" stroke-width="1" stroke-dasharray="3 3" />
            <rect x="@px(value)" y="@y" width="@(600 - px(value))" height="24" rx="4"
                  fill="var(--mud-palette-primary)" opacity="0.2" />
            <line x1="@px(value)" y1="@y" x2="@px(value)" y2="@(y + 24)"
                  stroke="var(--mud-palette-primary)" stroke-width="2" />
            @* name to the left of the bar, number inside it: "Gesichert staatsgefährdend" is too long to fit inside *@
            <text x="@(px(value) - 8)" y="@(y + 17)" font-size="11" text-anchor="end"
                  fill="var(--mud-palette-text-primary)">@name</text>
            <text x="@(px(value) + 10)" y="@(y + 17)" font-size="11"
                  fill="var(--mud-palette-primary)">ab @value</text>
        </g>
    }

    <line x1="16" y1="266" x2="624" y2="266"
          stroke="var(--mud-palette-lines-default)" stroke-width="1" stroke-dasharray="4 4" />
    <text x="16" y="286" font-size="11" fill="var(--mud-palette-text-primary)">
        Über dem Sockel zählt, was dokumentiert ist: Aktivitäten, Doks, Observationen, Größe, Konflikte.
    </text>
    <text x="16" y="306" font-size="10" fill="var(--mud-palette-warning)">
        Frisches wiegt schwerer als Altes. Eine leere Akte ergibt eine niedrige Zahl - ein Befund über uns.
    </text>
</svg>
