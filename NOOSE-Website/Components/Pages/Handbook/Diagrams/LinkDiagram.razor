@* A link is one row seen from both sides - the single most common misunderstanding about records. *@

<svg viewBox="0 0 640 260" role="img" aria-labelledby="linkDiagramTitle linkDiagramDesc"
     style="width:100%;height:auto;max-width:640px;">
    <title id="linkDiagramTitle">Eine Verknüpfung, zwei Seiten</title>
    <desc id="linkDiagramDesc">
        Eine einmal angelegte Verknüpfung erscheint auf beiden beteiligten Akten. Sie muss nie doppelt
        gepflegt werden.
    </desc>

    <!-- left record -->
    <rect x="16" y="40" width="230" height="96" rx="8"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="36" y="66" font-size="13" fill="var(--mud-palette-text-primary)">Personenakte</text>
    <text x="36" y="86" font-size="11" fill="var(--mud-palette-text-secondary)">Abschnitt Verknüpfungen</text>
    <rect x="36" y="98" width="190" height="24" rx="4"
          fill="var(--mud-palette-primary)" opacity="0.2" />
    <text x="46" y="114" font-size="10" fill="var(--mud-palette-text-primary)">→ Fraktion · „gehört zu“</text>

    <!-- right record -->
    <rect x="394" y="40" width="230" height="96" rx="8"
          fill="var(--mud-palette-surface)" stroke="var(--mud-palette-lines-default)" stroke-width="1.5" />
    <text x="414" y="66" font-size="13" fill="var(--mud-palette-text-primary)">Fraktionsakte</text>
    <text x="414" y="86" font-size="11" fill="var(--mud-palette-text-secondary)">Abschnitt Verknüpfungen</text>
    <rect x="414" y="98" width="190" height="24" rx="4"
          fill="var(--mud-palette-primary)" opacity="0.2" />
    <text x="424" y="114" font-size="10" fill="var(--mud-palette-text-primary)">→ Person · „gehört zu“</text>

    <!-- the one link between them -->
    <line x1="246" y1="88" x2="394" y2="88" stroke="var(--mud-palette-primary)" stroke-width="2" />
    <path d="M 256 82 L 246 88 L 256 94" fill="none" stroke="var(--mud-palette-primary)" stroke-width="2" />
    <path d="M 384 82 L 394 88 L 384 94" fill="none" stroke="var(--mud-palette-primary)" stroke-width="2" />
    <rect x="272" y="70" width="96" height="36" rx="6"
          fill="var(--mud-palette-background)" stroke="var(--mud-palette-primary)" stroke-width="1.5" />
    <text x="320" y="86" font-size="11" text-anchor="middle" fill="var(--mud-palette-primary)">eine</text>
    <text x="320" y="100" font-size="11" text-anchor="middle" fill="var(--mud-palette-primary)">Verknüpfung</text>

    <text x="320" y="30" font-size="11" text-anchor="middle" fill="var(--mud-palette-text-secondary)">
        einmal angelegt
    </text>

    <line x1="16" y1="172" x2="624" y2="172"
          stroke="var(--mud-palette-lines-default)" stroke-width="1" stroke-dasharray="4 4" />
    <text x="16" y="194" font-size="11" fill="var(--mud-palette-text-primary)">
        Du legst sie auf einer Seite an - sie steht sofort auf beiden.
    </text>
    <text x="16" y="214" font-size="11" fill="var(--mud-palette-text-secondary)">
        Zu jeder Verknüpfung gehört eine Art und möglichst eine kurze Notiz, warum sie besteht.
    </text>
    <text x="16" y="238" font-size="10" fill="var(--mud-palette-warning)">
        Ohne Begründung ist eine Verknüpfung in drei Wochen nicht mehr nachvollziehbar.
    </text>
</svg>
