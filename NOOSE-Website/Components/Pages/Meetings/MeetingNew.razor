@page "/besprechungen/neu"
@attribute [Authorize(Policy = Policies.HighestClassificationPage)]
@inject IMeetingService MeetingService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Neue Besprechung – NOOSE</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/besprechungen" aria-label="Zurück" />
    <MudText Typo="Typo.h5">Neue Besprechung</MudText>
</MudStack>

<MudPaper Class="pa-4" Elevation="1" Style="max-width:820px;">
    <MeetingForm Input="_input" />

    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
        <MudButton Href="/besprechungen">Abbrechen</MudButton>
        <AuthorizeView Policy="@Policies.WriteAccess">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                       Disabled="@(_saving || string.IsNullOrWhiteSpace(_input.Title) || _input.Start is null)">
                Anlegen
            </MudButton>
        </AuthorizeView>
    </MudStack>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private readonly MeetingInput _input = new() { Start = DateTime.Now.Date.AddDays(1).AddHours(20) };
    private bool _saving;

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var user = (await AuthStateTask!).User;
            var meeting = await MeetingService.CreateAsync(_input, user);
            Snackbar.Add($"Besprechung {meeting.CaseNumber} angelegt.", Severity.Success);
            Nav.NavigateTo($"/besprechungen/{meeting.Id}");
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }
}
