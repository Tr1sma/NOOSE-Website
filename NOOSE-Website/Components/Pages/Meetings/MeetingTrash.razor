@page "/besprechungen/papierkorb"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@inject IMeetingService MeetingService
@inject ISnackbar Snackbar

<PageTitle>Papierkorb – Besprechungen · NOOSE</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/besprechungen" aria-label="Zurück" />
    <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" Size="Size.Large" />
    <MudText Typo="Typo.h4">Papierkorb – Besprechungen</MudText>
</MudStack>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Gelöschte Besprechungen. Die Führung kann sie wiederherstellen; sie erscheinen dann wieder in der Liste.
</MudText>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_meetings.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Der Papierkorb ist leer.</MudAlert>
}
else
{
    <MudTable Items="_meetings" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="Meeting" SortBy="@(x => x.CaseNumber)">Aktenzeichen</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="Meeting" SortBy="@(x => x.Title)">Titel</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="Meeting" SortBy="@(x => x.Start)">Beginn</MudTableSortLabel></MudTh>
            <MudTh>Ort</MudTh>
            <MudTh>Status</MudTh>
            <MudTh><MudTableSortLabel T="Meeting" SortBy="@(x => x.DeletedAt)" InitialDirection="SortDirection.Descending">Gelöscht am</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;">Aktion</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktenzeichen"><MudText Typo="Typo.body2">@context.CaseNumber</MudText></MudTd>
            <MudTd DataLabel="Titel"><MudText Typo="Typo.body2">@context.Title</MudText></MudTd>
            <MudTd DataLabel="Beginn">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @MeetingTime.Local(context.Start).ToString("dd.MM.yyyy HH:mm")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Ort"><MudText Typo="Typo.body2">@(context.Location ?? "—")</MudText></MudTd>
            <MudTd DataLabel="Status"><MeetingStatusChip Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Gelöscht am">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(context.DeletedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Aktion" Style="text-align:right;">
                @* LeadershipPage admits read-only supervision, for whom RestoreAsync throws *@
                <AuthorizeView Policy="@Policies.WriteAccess" Context="write">
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(() => RestoreAsync(context))">Wiederherstellen</MudButton>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _load = true;
    private List<Meeting> _meetings = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _load = true;
        _meetings = await MeetingService.GetTrashAsync();
        _load = false;
    }

    private async Task RestoreAsync(Meeting meeting)
    {
        var user = (await AuthStateTask!).User;
        try
        {
            await MeetingService.RestoreAsync(meeting.Id, user);
            Snackbar.Add($"Besprechung {meeting.CaseNumber} wiederhergestellt.", Severity.Success);
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        await LoadAsync();
    }
}
