@page "/besprechungen/{Id}/bearbeiten"
@attribute [Authorize(Policy = Policies.HighestClassificationPage)]
@inject IMeetingService MeetingService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Besprechung bearbeiten – NOOSE</PageTitle>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_input is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Besprechung nicht gefunden.</MudAlert>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="@($"/besprechungen/{Id}")" aria-label="Zurück" />
        <MudText Typo="Typo.h5">Besprechung bearbeiten</MudText>
    </MudStack>

    <MudPaper Class="pa-4" Elevation="1" Style="max-width:820px;">
        <MeetingForm Input="_input" ShowStatus="true" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
            <MudButton Href="@($"/besprechungen/{Id}")">Abbrechen</MudButton>
            <AuthorizeView Policy="@Policies.WriteAccess">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                           Disabled="@(_saving || string.IsNullOrWhiteSpace(_input.Title) || _input.Start is null)">
                    Speichern
                </MudButton>
            </AuthorizeView>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public string Id { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private MeetingInput? _input;
    private bool _load = true;
    private bool _saving;

    protected override async Task OnParametersSetAsync()
    {
        _load = true;
        var meeting = await MeetingService.GetDetailAsync(Id);
        _input = meeting is null ? null : new MeetingInput
        {
            Title = meeting.Title,
            // stored UTC, edited in local wall-clock
            Start = MeetingTime.Local(meeting.Start),
            End = meeting.End is { } e ? MeetingTime.Local(e) : null,
            Location = meeting.Location,
            Status = meeting.Status,
        };
        _load = false;
    }

    private async Task SaveAsync()
    {
        if (_input is null)
        {
            return;
        }
        _saving = true;
        try
        {
            var user = (await AuthStateTask!).User;
            await MeetingService.RefreshAsync(Id, _input, user);
            Snackbar.Add("Besprechung gespeichert.", Severity.Success);
            Nav.NavigateTo($"/besprechungen/{Id}");
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }
}
