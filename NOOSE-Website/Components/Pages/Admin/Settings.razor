@page "/einstellungen"
@attribute [Authorize(Policy = Policies.LeadershipPage)]
@using NOOSE_Website.Navigation
@inject NavigationManager Nav

<PageTitle>Einstellungen · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.SettingsApplications"
            Title="Einstellungen"
            Subtitle="Alles, was sich an der Seite konfigurieren lässt, an einer Stelle." />

@* Admin-only sections are wrapped, so they neither render nor register a rail button. *@
<RecordSectionRail>
    <AuthorizeView Policy="@Policies.AdminPage" Context="systemSection">
        <RecordSection Group="Betrieb" Slug="system" Label="System &amp; Erscheinungsbild"
                       Icon="@Icons.Material.Filled.SettingsApplications">
            <SystemSettingsPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Betrieb" Slug="discord" Label="Discord-Benachrichtigungen"
                   Icon="@Icons.Material.Filled.Notifications">
        <DiscordPanel />
    </RecordSection>

    <RecordSection Group="Betrieb" Slug="bester-agent" Label="Bester Agent der Woche"
                   Icon="@Icons.Material.Filled.EmojiEvents">
        <BestAgentPanel />
    </RecordSection>

    <AuthorizeView Policy="@Policies.AdminPage" Context="statusSection">
        <RecordSection Group="Betrieb" Slug="status" Label="System-Status"
                       Icon="@Icons.Material.Filled.MonitorHeart">
            <SystemStatusPanel />
        </RecordSection>
    </AuthorizeView>

    <RecordSection Group="Akten-Konfiguration" Slug="custom-felder" Label="Custom-Felder"
                   Icon="@Icons.Material.Filled.Tune">
        <CustomFieldDefinitionsPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="tags" Label="Tags"
                   Icon="@Icons.Material.Filled.Label">
        <TagsPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="aktualitaet" Label="Aktualitäts-Ampel"
                   Icon="@Icons.Material.Filled.Timelapse">
        <RecencyPanel />
    </RecordSection>
    <RecordSection Group="Akten-Konfiguration" Slug="bedrohungs-score" Label="Bedrohungs-Score"
                   Icon="@Icons.Material.Filled.Speed">
        <ThreatScorePanel />
    </RecordSection>

    @* the former /admin/vorlagen tab page: one rail section per template family *@
    <RecordSection Group="Vorlagen" Slug="vorlagen-dok" Label="Dok-Vorlagen"
                   Icon="@Icons.Material.Filled.Dvr">
        <DocTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-dokument" Label="Dokument-Vorlagen"
                   Icon="@Icons.Material.Filled.Article">
        <DocumentTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-aktivitaet" Label="Aktivitäts-Vorlagen"
                   Icon="@Icons.Material.Filled.Bolt">
        <ActivityTemplatesManagement />
    </RecordSection>
    <RecordSection Group="Vorlagen" Slug="vorlagen-personal" Label="Personal-Vorlagen"
                   Icon="@Icons.Material.Filled.Badge">
        <PersonnelTemplatesManagement />
    </RecordSection>

    <RecordSection Group="Personal" Slug="module" Label="Ausbildungsmodule"
                   Icon="@Icons.Material.Filled.School">
        <TrainingModulesPanel />
    </RecordSection>
    <RecordSection Group="Personal" Slug="einladungen" Label="Einladungen"
                   Icon="@Icons.Material.Filled.PersonAddAlt">
        <InvitesPanel />
    </RecordSection>

    <RecordSection Group="Finanzierung" Slug="finanzierung" Label="Budget-Regeln"
                   Icon="@Icons.Material.Filled.RequestQuote">
        <FinancingRulesPanel />
    </RecordSection>

    <RecordSection Group="KI" Slug="noosei" Label="NOOSEI-Betrieb"
                   Icon="@Icons.Material.Filled.SmartToy">
        <NooseiOperationsPanel />
    </RecordSection>
    <RecordSection Group="KI" Slug="ki-regeln" Label="Token-Regeln"
                   Icon="@Icons.Material.Filled.Rule">
        <LlmQuotaRulesPanel />
    </RecordSection>
    @* aggregates only, no prompt text — so this stays at leadership and needs no counter-intel gate *@
    <RecordSection Group="KI" Slug="ki-betrieb" Label="Betriebszahlen"
                   Icon="@Icons.Material.Filled.QueryStats">
        <NooseiHealthPanel />
    </RecordSection>
    <RecordSection Group="KI" Slug="ki-kontingente" Label="Kontingente"
                   Icon="@Icons.Material.Filled.Token">
        <LlmQuotaOverviewPanel />
    </RecordSection>
    @* Prompts and answers are stored in full: agents do paste real names, and supervision must never see those. *@
    <AuthorizeView Policy="@Policies.CounterIntel" Context="kiLogSection">
        <RecordSection Group="KI" Slug="ki-anfragen" Label="Anfragen"
                       Icon="@Icons.Material.Filled.Forum">
            <LlmRequestLogPanel />
        </RecordSection>
    </AuthorizeView>

    <AuthorizeView Policy="@Policies.AdminPage" Context="partnerSection">
        <RecordSection Group="Partnerbehörden" Slug="partner" Label="Sichtbarkeit &amp; Freigaben"
                       Icon="@Icons.Material.Filled.Handshake">
            <PartnerPanel />
        </RecordSection>
    </AuthorizeView>

    @* Protokoll and Gegenaufklärung moved to /nachweis; only the value lists stay here. *@
    <RecordSection Group="Nachweis" Slug="basisdaten" Label="Wertelisten"
                   Icon="@Icons.Material.Filled.Storage">
        <BaseDataPanel />
    </RecordSection>
</RecordSectionRail>

@code {
    // three sections left for /nachweis; forward old deep links instead of silently falling back
    protected override void OnInitialized()
    {
        if (LegacyRoutes.MovedSettingsTab(QueryState.Read(Nav, "tab")) is { } target)
        {
            Nav.NavigateTo(target, replace: true);
        }
    }
}
