@page "/chronik"
@using NOOSE_Website.Models.Timeline
@attribute [Authorize(Policy = Policies.InternalAgent)]
@inject IGlobalChronikService Chronik
@inject INavPreferencesService NavPreferences
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Chronik · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Timeline"
            Title="Ermittlungs-Chronik"
            Subtitle="Behördenweiter Verlauf aller Akten-Ereignisse." />

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            @foreach (var preset in Presets)
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_customRange is null && _presetDays == preset.Days ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Primary" OnClick="@(() => OnPresetAsync(preset.Days))">
                    @preset.Label
                </MudChip>
            }
            <MudDateRangePicker Label="Zeitraum" DateRange="_customRange" DateRangeChanged="OnCustomRangeAsync"
                                Clearable="true" Margin="Margin.Dense" Style="min-width:230px;" />
            <MudSpacer />
            <MudTextField T="string" Value="_text" ValueChanged="OnTextAsync" Immediate="true"
                          DebounceInterval="400" Placeholder="Akte, Ereignis oder Agent suchen"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                          Style="min-width:260px;" />
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudSelect T="string" Label="Aktentyp" MultiSelection="true" SelectedValues="_types"
                       SelectedValuesChanged="OnTypesAsync" Dense="true" Margin="Margin.Dense"
                       Style="min-width:210px;" MultiSelectionTextFunc="@(v => TypeSummary(v))">
                @foreach (var t in _options.Types)
                {
                    <MudSelectItem T="string" Value="@t">@RecordTypeDisplay.Name(t)</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Label="Agent" MultiSelection="true" SelectedValues="_agents"
                       SelectedValuesChanged="OnAgentsAsync" Dense="true" Margin="Margin.Dense"
                       Style="min-width:210px;">
                @foreach (var a in _options.Agents)
                {
                    <MudSelectItem T="string" Value="@a.Id">@a.Name</MudSelectItem>
                }
            </MudSelect>

            <MudDivider Vertical="true" FlexItem="true" />

            @foreach (var category in FilterCategories)
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_categories.Contains(category) ? Variant.Filled : Variant.Outlined)"
                         Color="@TimelineCategoryDisplay.Colour(category)"
                         Icon="@TimelineCategoryDisplay.Symbol(category)"
                         OnClick="@(() => OnCategoryAsync(category))">
                    @TimelineCategoryDisplay.Name(category)
                </MudChip>
            }

            @if (HasFilters)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff"
                           OnClick="ResetFiltersAsync">Filter zurücksetzen</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-2 mb-3" Elevation="1">
    <ChronikStrip Buckets="_buckets" WindowStartUtc="_windowFrom" WindowEndUtc="_windowTo"
                  OnRangeChanged="OnRangeChangedAsync" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary px-2">
        Ziehen zum Verschieben, Scrollen zum Zoomen — der Feed folgt dem sichtbaren Ausschnitt.
    </MudText>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudPaper Class="pa-4" Elevation="1">
    <ChronikFeed Events="_events" LastSeenUtc="_lastSeen" />

    @if (_hasMore)
    {
        <MudStack AlignItems="AlignItems.Center" Class="mt-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_loadMore"
                       StartIcon="@Icons.Material.Filled.ExpandMore" OnClick="LoadMoreAsync">
                @(_loadMore ? "Lädt …" : "Mehr laden")
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private static readonly (int Days, string Label)[] Presets =
    {
        (1, "Heute"), (7, "7 Tage"), (30, "30 Tage"), (90, "90 Tage"),
    };

    private static readonly TimelineCategory[] FilterCategories =
    {
        TimelineCategory.Asset, TimelineCategory.Change, TimelineCategory.Classification,
        TimelineCategory.Doc, TimelineCategory.Comment, TimelineCategory.Source,
        TimelineCategory.Membership, TimelineCategory.Relation, TimelineCategory.Allocation,
        TimelineCategory.Followup, TimelineCategory.ThreatScore,
        TimelineCategory.Deletion, TimelineCategory.Restoration,
    };

    private ClaimsPrincipal _user = default!;
    private string? _agentId;
    private ChronikFilterOptions _options = new(Array.Empty<string>(), Array.Empty<ChronikAgentOption>());

    private List<ChronikEvent> _events = new();
    private IReadOnlyList<ChronikDensityBucket> _buckets = Array.Empty<ChronikDensityBucket>();
    private DateTime? _cursor;
    private bool _hasMore;
    private bool _load = true;
    private bool _loadMore;
    private int _loadGen;
    private DateTime? _lastSeen;

    private int _presetDays = 30;
    private DateRange? _customRange;
    private DateTime _windowFrom;
    private DateTime _windowTo;
    private DateTime _from;
    private DateTime _to;

    private HashSet<string> _types = new();
    private HashSet<string> _agents = new();
    private readonly HashSet<TimelineCategory> _categories = new();
    private string? _text;

    private bool HasFilters => _types.Count > 0 || _agents.Count > 0 || _categories.Count > 0
        || !string.IsNullOrWhiteSpace(_text);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        _options = await Chronik.GetFilterOptionsAsync(_user);

        ReadUrlState();
        ApplyWindow();

        if (!string.IsNullOrEmpty(_agentId))
        {
            var prefs = await NavPreferences.GetAsync(_agentId);
            _lastSeen = prefs.ChronikLastSeenUtc;
        }

        await ReloadAsync(withDensity: true);

        if (!string.IsNullOrEmpty(_agentId))
        {
            // stamp after the first load so the divider still reflects the previous visit
            await NavPreferences.SetChronikLastSeenAsync(_agentId, DateTime.UtcNow);
        }
    }

    // ---------------------------------------------------------------- loading

    private ChronikQuery BuildQuery(DateTime? before) => new(
        _from, _to,
        _types.Count == 0 ? null : _types.ToList(),
        _agents.Count == 0 ? null : _agents.ToList(),
        _categories.Count == 0 ? null : _categories.ToList(),
        string.IsNullOrWhiteSpace(_text) ? null : _text,
        before);

    private async Task ReloadAsync(bool withDensity)
    {
        var gen = ++_loadGen;
        _load = true;
        StateHasChanged();

        if (withDensity)
        {
            var densityQuery = BuildQuery(null) with { FromUtc = _windowFrom, ToUtc = _windowTo };
            var buckets = await Chronik.GetDensityAsync(densityQuery, _user);
            if (gen != _loadGen)
            {
                return;
            }
            _buckets = buckets;
        }

        var result = await Chronik.GetEventsAsync(BuildQuery(null), _user);
        if (gen != _loadGen)
        {
            return; // a newer filter/pan load superseded this one
        }
        _events = result.Events.ToList();
        _cursor = result.NextCursorUtc;
        _hasMore = result.HasMore;
        _load = false;
        StateHasChanged();
    }

    private async Task LoadMoreAsync()
    {
        if (_cursor is not { } cursor || _loadMore)
        {
            return;
        }
        var gen = _loadGen;
        _loadMore = true;
        StateHasChanged();

        var result = await Chronik.GetEventsAsync(BuildQuery(cursor), _user);
        if (gen != _loadGen)
        {
            return;
        }
        _events.AddRange(result.Events);
        _cursor = result.NextCursorUtc;
        _hasMore = result.HasMore;
        _loadMore = false;
        StateHasChanged();
    }

    // ---------------------------------------------------------------- filters

    private async Task OnPresetAsync(int days)
    {
        _presetDays = days;
        _customRange = null;
        ApplyWindow();
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: true);
    }

    private async Task OnCustomRangeAsync(DateRange? range)
    {
        _customRange = range?.Start is null || range.End is null ? null : range;
        ApplyWindow();
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: true);
    }

    private async Task OnTypesAsync(IEnumerable<string> values)
    {
        _types = values.ToHashSet();
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: true);
    }

    private async Task OnAgentsAsync(IEnumerable<string> values)
    {
        _agents = values.ToHashSet();
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: true);
    }

    private async Task OnCategoryAsync(TimelineCategory category)
    {
        if (!_categories.Remove(category))
        {
            _categories.Add(category);
        }
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: false);
    }

    private async Task OnTextAsync(string? value)
    {
        _text = value;
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: false);
    }

    private async Task ResetFiltersAsync()
    {
        _types.Clear();
        _agents.Clear();
        _categories.Clear();
        _text = null;
        await WriteUrlStateAsync();
        await ReloadAsync(withDensity: true);
    }

    // pan/zoom inside the band picks a sub-range of the current window
    private async Task OnRangeChangedAsync((DateTime From, DateTime To) range)
    {
        if (Math.Abs((range.From - _from).TotalSeconds) < 2 && Math.Abs((range.To - _to).TotalSeconds) < 2)
        {
            return;
        }
        _from = range.From < _windowFrom ? _windowFrom : range.From;
        _to = range.To > _windowTo ? _windowTo : range.To;
        await ReloadAsync(withDensity: false);
    }

    // ---------------------------------------------------------------- window + url

    private void ApplyWindow()
    {
        if (_customRange is { Start: { } start, End: { } end })
        {
            _windowFrom = DateTime.SpecifyKind(start.Date, DateTimeKind.Local).ToUniversalTime();
            _windowTo = DateTime.SpecifyKind(end.Date.AddDays(1), DateTimeKind.Local).ToUniversalTime();
        }
        else
        {
            _windowTo = DateTime.UtcNow.AddMinutes(1);
            var firstDay = DateTime.Now.Date.AddDays(-(_presetDays - 1));
            _windowFrom = DateTime.SpecifyKind(firstDay, DateTimeKind.Local).ToUniversalTime();
        }
        _from = _windowFrom;
        _to = _windowTo;
    }

    private void ReadUrlState()
    {
        if (int.TryParse(QueryState.Read(Nav, "zeit"), out var days) && Presets.Any(p => p.Days == days))
        {
            _presetDays = days;
        }
        if (DateTime.TryParse(QueryState.Read(Nav, "von"), out var from)
            && DateTime.TryParse(QueryState.Read(Nav, "bis"), out var to))
        {
            _customRange = new DateRange(from.Date, to.Date);
        }
        _types = SplitCsv(QueryState.Read(Nav, "typ")).Where(_options.Types.Contains).ToHashSet();
        _agents = SplitCsv(QueryState.Read(Nav, "agent")).Where(a => _options.Agents.Any(o => o.Id == a)).ToHashSet();
        foreach (var raw in SplitCsv(QueryState.Read(Nav, "kat")))
        {
            if (Enum.TryParse<TimelineCategory>(raw, ignoreCase: true, out var category))
            {
                _categories.Add(category);
            }
        }
        _text = QueryState.Read(Nav, "q");
    }

    private Task WriteUrlStateAsync() => QueryState.WriteAsync(JS, Nav,
        ("zeit", _customRange is null ? _presetDays.ToString() : null),
        ("von", _customRange?.Start?.ToString("yyyy-MM-dd")),
        ("bis", _customRange?.End?.ToString("yyyy-MM-dd")),
        ("typ", _types.Count == 0 ? null : string.Join(',', _types)),
        ("agent", _agents.Count == 0 ? null : string.Join(',', _agents)),
        ("kat", _categories.Count == 0 ? null : string.Join(',', _categories)),
        ("q", _text));

    private static IEnumerable<string> SplitCsv(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? Array.Empty<string>()
            : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string TypeSummary(IReadOnlyList<string>? selected)
        => selected is not { Count: > 0 }
            ? "Alle Typen"
            : selected.Count <= 2
                ? string.Join(", ", selected.Select(RecordTypeDisplay.Name))
                : $"{selected.Count} Typen";
}
