@page "/suche"
@using System.Text.Json
@using NOOSE_Website.Services.Search
@inject ISearchService SearchService
@inject ISavedSearchService SavedSearchService
@inject ITagService TagService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Suche · NOOSE</PageTitle>

<PageHeader Icon="@Icons.Material.Filled.Search" Title="Globale Suche">
    <SubtitleContent>
        Durchsucht <b>alles, was du sehen darfst</b> — Akten, Inhalte und persönliche Einträge.
        <b>Es gibt keine Vorfilter:</b> Kategorien erscheinen unten als Filter <i>auf das Ergebnis</i>, damit man
        sich keine Treffer wegklicken kann. Die <b>Smart-Suche</b> toleriert Tippfehler; der <b>Deep-Scan</b> nimmt
        alle Nebenfelder dazu (Steckbrief, Telefonnummern, Fahrzeuge, Orte, Waffen).
        Verschlusssachen erscheinen nur für die Führung.
    </SubtitleContent>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_text" Placeholder="Suchbegriff…" Variant="Variant.Outlined" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="SearchKeyDown" Class="flex-grow-1 mt-0" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       OnClick="SearchAsync">Suchen</MudButton>
        </MudStack>

        <MudStack Row="true" Spacing="3" Class="flex-wrap" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Modus:</MudText>
            <MudTooltip Text="Findet Treffer auch bei Tippfehlern (Levenshtein + phonetischer Index).">
                <MudCheckBox T="bool" @bind-Value="_fuzzy" Label="Smart-Suche" Dense="true" Color="Color.Primary" />
            </MudTooltip>
            <MudTooltip Text="Nimmt alle Nebenfelder dazu (Steckbrief, Telefon, Fahrzeuge, Orte, Waffen) – toleranter, aber langsamer.">
                <MudCheckBox T="bool" @bind-Value="_maxMode" Label="Deep-Scan" Dense="true" Color="Color.Secondary" />
            </MudTooltip>
            @if (_tags.Count > 0)
            {
                <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_tagSelection" Label="Tags" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;"
                           MultiSelectionTextFunc="@(items => $"{items.Count} Tag(s)")">
                    @foreach (var t in _tags)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Text="@TagScopeHint">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mud-text-secondary" />
                </MudTooltip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
            <MudTextField @bind-Value="_saveName" Placeholder="Suche speichern als…" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Style="max-width:240px;" Class="mt-0" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.BookmarkAdd"
                       OnClick="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(_saveName)">Speichern</MudButton>

            @if (_saved.Count > 0)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Gespeichert:</MudText>
                @foreach (var g in _saved)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             OnClick="@(() => ApplyAsync(g))" OnClose="@(() => SearchDeleteAsync(g))">@g.Name</MudChip>
                }
            }
        </MudStack>
    </MudStack>
</MudPaper>

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_searched)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Suchbegriff eingeben oder Tags wählen und „Suchen" klicken.</MudText>
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 flex-wrap">
        <MudText Typo="Typo.subtitle1">
            @if (_facet is null)
            {
                <text>@_results.Total Treffer in @_results.Groups.Count Kategorien</text>
            }
            else
            {
                <text>@ShownCount Treffer · @SearchCatalog.Plural(_facet)</text>
            }
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @_results.Searched.Count von @_results.VisibleCategories Kategorien durchsucht ·
            @_results.Elapsed.TotalSeconds.ToString("0.0") s
        </MudText>
        <MudSpacer />
        @if (_facet is not null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="@(() => FacetAsync(null))">Filter aufheben</MudButton>
        }
    </MudStack>

    @if (_results.Incomplete.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3"
                  Icon="@Icons.Material.Filled.HourglassBottom">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudText Typo="Typo.body2">
                    <b>Unvollständig.</b> Das Zeitbudget war erschöpft. Diese Kategorien wurden nicht zu Ende
                    durchsucht — <b>0 Treffer heißt hier nicht „nichts da"</b>:
                    @string.Join(", ", _results.Incomplete.Select(SearchCatalog.Plural)).
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Bolt" OnClick="SearchRestAsync">Rest nachladen</MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (_results.Total == 0)
    {
        <EmptyState Icon="@Icons.Material.Filled.SearchOff" Title="Keine Treffer."
                    Text="@($"Durchsucht wurden {_results.Searched.Count} Kategorien — alles, was du sehen darfst.")">
            <Actions>
                @if (!_fuzzy)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Spellcheck"
                               OnClick="@(async () => { _fuzzy = true; await SearchAsync(); })">Smart-Suche einschalten</MudButton>
                }
                @if (!_maxMode)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ZoomIn"
                               OnClick="@(async () => { _maxMode = true; await SearchAsync(); })">Deep-Scan</MudButton>
                }
            </Actions>
        </EmptyState>
    }
    else
    {
        @if (_results.Groups.Count > 1)
        {
            <SearchFacetBar Results="_results" Active="_facet" ActiveChanged="FacetAsync" />
        }

        <MudStack Spacing="4">
            @foreach (var group in Shown())
            {
                <div>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudIcon Icon="@SearchCatalog.Icon(group.Category)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1">@group.Display</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @group.Hit.Count@(group.Capped ? "+" : "")
                        </MudText>
                        @if (group.Capped)
                        {
                            <MudTooltip Text="Nur die ersten Treffer dieser Kategorie – Suche eingrenzen.">
                                <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Class="mud-text-secondary" />
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudStack Spacing="2">
                        @foreach (var t in group.Hit)
                        {
                            <SearchHitRow Hit="t" />
                        }
                    </MudStack>
                </div>
            }
        </MudStack>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "kat")] private string? Kat { get; set; }

    private ClaimsPrincipal _user = default!;
    private string? _agentId;

    private string _text = string.Empty;
    private bool _fuzzy;
    private bool _maxMode;
    private string? _facet;
    private IReadOnlyCollection<string> _tagSelection = new HashSet<string>();
    private string _saveName = string.Empty;

    private bool _load;
    private bool _searchingNow;
    private bool _againSearch;
    private bool _searched;
    private SearchResults _results = SearchResults.None;
    private List<Tag> _tags = new();
    private List<SavedSearch> _saved = new();

    private string? _appliedQ;

    /// <summary>Derived, not hand-written: a hardcoded list of tagless categories goes stale on the next one.</summary>
    private static readonly string TagScopeHint =
        "Ein Tag-Filter wirkt nur auf Kategorien mit Stichwort-Zuordnung. Ohne Zuordnung und damit ausgelassen: "
        + string.Join(", ", SearchCatalog.Categories
            .Where(c => !c.Has(SearchTraits.Tagged)).Select(c => c.Plural)) + ".";

    private IEnumerable<SearchResultGroup> Shown()
        => _facet is null ? _results.Groups : _results.Groups.Where(g => g.Category == _facet);

    private int ShownCount => Shown().Sum(g => g.Hit.Count);

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        _agentId = _user.GetAgentId();
        // partners: no internal tag vocabulary
        if (!_user.IsPartner())
        {
            _tags = await TagService.GetAllAsync();
        }
        await SavedLoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // real navigations only: QueryState.WriteAsync goes through replaceState, which raises no LocationChanged
        if (Q == _appliedQ)
        {
            return;
        }
        _appliedQ = Q;
        _facet = Kat is { Length: > 0 } && SearchCatalog.Find(Kat) is not null ? Kat : null;
        if (!string.IsNullOrWhiteSpace(Q))
        {
            _text = Q;
            await SearchAsync();
        }
    }

    private async Task SavedLoadAsync()
    {
        if (_agentId is not null)
        {
            _saved = await SavedSearchService.GetForAgentAsync(_agentId);
        }
    }

    private async Task SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private SearchCriteria BuildCriteria() => new()
    {
        Text = _text,
        Facet = _facet,
        TagIds = _tagSelection.ToList(),
        Fuzzy = _fuzzy,
        MaxMode = _maxMode,
        // Categories stays empty: the page never pre-filters, so nothing can be hidden from the reader
    };

    private async Task SearchAsync()
    {
        // a search already runs; queue a rerun instead of overlapping
        if (_searchingNow)
        {
            _againSearch = true;
            return;
        }

        _searchingNow = true;
        _load = true;
        StateHasChanged();
        try
        {
            do
            {
                _againSearch = false;
                _results = await SearchService.SearchAsync(BuildCriteria(), _user);
                _searched = true;
            }
            while (_againSearch);
            await UrlAsync();
        }
        catch (Exception ex)
        {
            // surface the error instead of hanging the spinner
            _results = SearchResults.None;
            _searched = true;
            Snackbar.Add($"Suche fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
            _searchingNow = false;
        }
    }

    /// <summary>Re-runs only the categories the budget cut off and merges them in.</summary>
    /// <remarks>The one place the page restricts categories server-side — and it says so on a button rather than
    /// doing it silently.</remarks>
    private async Task SearchRestAsync()
    {
        if (_results.Incomplete.Count == 0)
        {
            return;
        }
        _load = true;
        StateHasChanged();
        try
        {
            var criteria = BuildCriteria();
            criteria.Categories = _results.Incomplete.ToList();
            var rest = await SearchService.SearchAsync(criteria, _user);
            var groups = _results.Groups
                .Where(g => !_results.Incomplete.Contains(g.Category))
                .Concat(rest.Groups)
                .OrderBy(g => SearchCatalog.Index(g.Category))
                .ToList();
            _results = new SearchResults(groups, groups.Sum(g => g.Hit.Count),
                _results.Searched.Concat(rest.Searched).Distinct().ToList(),
                rest.Incomplete, _results.VisibleCategories, _results.Elapsed + rest.Elapsed);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nachladen fehlgeschlagen: {ex.Message}", Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private Task FacetAsync(string? category)
    {
        // no re-query: Shown() filters the groups already fetched
        _facet = category;
        return UrlAsync();
    }

    private async Task UrlAsync()
    {
        await QueryState.WriteAsync(JS, Nav, ("q", _text), ("kat", _facet));
        // replaceState raises no LocationChanged, so Q still holds the old value. Without this the guard in
        // OnParametersSetAsync swallows the next real navigation from the header search box.
        _appliedQ = string.IsNullOrWhiteSpace(_text) ? null : _text;
    }

    private async Task SaveAsync()
    {
        if (_agentId is null)
        {
            return;
        }
        try
        {
            await SavedSearchService.SaveAsync(_agentId, _saveName, BuildCriteria(), _user);
            Snackbar.Add($"Suche „{_saveName.Trim()}“ gespeichert.", Severity.Success);
            _saveName = string.Empty;
            await SavedLoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ApplyAsync(SavedSearch g)
    {
        SearchCriteria? k = null;
        try { k = JsonSerializer.Deserialize<SearchCriteria>(g.SearchParameterJson); }
        catch { /* ignore */ }
        if (k is null)
        {
            return;
        }

        _text = k.Text ?? string.Empty;
        _tagSelection = new HashSet<string>(k.TagIds ?? new());
        _fuzzy = k.Fuzzy;
        _maxMode = k.MaxMode;

        // rows saved with the old checkbox filter carry Categories as a PRE-filter. Deliberately not honoured:
        // it hid categories from the reader. A single saved category survives as the result facet.
        _facet = k.Facet is { Length: > 0 } f && SearchCatalog.Find(f) is not null ? f
            : k.Categories is [var only] && SearchCatalog.Find(only) is not null ? only
            : null;

        if (k.Facet is null && k.Categories is { Count: > 1 })
        {
            Snackbar.Add("Diese gespeicherte Suche stammt aus der alten Kategorie-Auswahl. Es wird jetzt immer "
                + "alles Sichtbare durchsucht; Kategorien filtern nur das Ergebnis.", Severity.Info);
        }

        await SearchAsync();
    }

    private async Task SearchDeleteAsync(SavedSearch g)
    {
        if (_agentId is null)
        {
            return;
        }
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Gespeicherte Suche löschen?",
            $"„{g.Name}“ wird dauerhaft entfernt.");
        if (!ok)
        {
            return;
        }
        await SavedSearchService.DeleteAsync(g.Id, _agentId);
        Snackbar.Add($"Suche „{g.Name}“ gelöscht.", Severity.Success);
        await SavedLoadAsync();
    }
}
