@* Pick kind + label for a link the analyst drew between two graph nodes. *@
@using NOOSE_Website.Models.Enums

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Verknüpfung anlegen</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            <b>@FromName</b> → <b>@ToName</b>
        </MudText>
        <MudSelect T="LinkKind" @bind-Value="_kind" Label="Art" Dense="true" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="LinkKind" Value="LinkKind.Default">Standard</MudSelectItem>
            <MudSelectItem T="LinkKind" Value="LinkKind.Conflict">Konflikt</MudSelectItem>
            <MudSelectItem T="LinkKind" Value="LinkKind.Alliance">Bündnis</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_label" Label="Bezeichnung (optional)" Variant="Variant.Outlined" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Verknüpfen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string FromName { get; set; } = string.Empty;
    [Parameter] public string ToName { get; set; } = string.Empty;

    private LinkKind _kind = LinkKind.Default;
    private string? _label;

    private void Submit() => MudDialog.Close(DialogResult.Ok((_kind, _label)));
    private void Cancel() => MudDialog.Cancel();
}
