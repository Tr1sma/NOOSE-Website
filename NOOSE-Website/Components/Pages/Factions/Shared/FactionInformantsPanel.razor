@* Informants linked to this faction. Empty for partners, full names for every internal agent. *@
@using NOOSE_Website.Models.Informants
@inject IInformantService Service

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_entries.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Informanten mit dieser Fraktion verknüpft.</MudText>
}
else
{
    <MudStack Spacing="2">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Verknüpfung wird in der Informanten-Akte gesetzt.
        </MudText>
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            @foreach (var e in _entries)
            {
                <MudTooltip Text="@($"{e.CaseNumber} · {InformantEnumDisplay.Status(e.Status)}")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColour(e.Status)"
                             Icon="@Icons.Material.Filled.VisibilityOff"
                             Href="@($"/informanten/{e.InformantId}")">@e.Name</MudChip>
                </MudTooltip>
            }
        </MudStack>
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string FactionId { get; set; } = default!;
    [Parameter] public ClaimsPrincipal? User { get; set; }

    private bool _load = true;
    private string _loadedFor = string.Empty;
    private List<InformantFactionEntry> _entries = new();

    protected override async Task OnParametersSetAsync()
    {
        if (User is null || FactionId == _loadedFor)
        {
            return;
        }
        _loadedFor = FactionId;
        _load = true;
        _entries = await Service.GetForFactionAsync(FactionId, User);
        _load = false;
    }

    private static Color StatusColour(InformantStatus s) => s switch
    {
        InformantStatus.Active => Color.Success,
        InformantStatus.Burned => Color.Error,
        _ => Color.Default,
    };
}
