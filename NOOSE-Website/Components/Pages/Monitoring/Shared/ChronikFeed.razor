@* Day-grouped chronicle feed. Presentational: takes events, renders them newest first. *@
@using NOOSE_Website.Models.Timeline

@if (Events.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.Timeline"
                Title="Keine Ereignisse im gewählten Zeitraum"
                Text="Zeitraum erweitern oder Filter zurücksetzen." />
}
else
{
    var newSince = FirstOlderIndex();
    var index = 0;

    <MudStack Spacing="4">
        @foreach (var day in Events.GroupBy(e => e.Timestamp.ToLocalTime().Date).OrderByDescending(g => g.Key))
        {
            <div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="chronik-tag">
                    <MudText Typo="Typo.subtitle2">@DayLabel(day.Key)</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@day.Count() Ereignisse</MudText>
                </MudStack>

                @foreach (var e in day.OrderByDescending(x => x.Timestamp))
                {
                    @if (index++ == newSince)
                    {
                        <div class="chronik-neu">Seit deinem letzten Besuch</div>
                    }
                    <div class="chronik-zeile">
                        <MudTooltip Text="@TimelineCategoryDisplay.Name(e.Category)">
                            <MudIcon Icon="@TimelineCategoryDisplay.Symbol(e.Category)" Size="Size.Small"
                                     Color="@TimelineCategoryDisplay.Colour(e.Category)" />
                        </MudTooltip>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @e.Timestamp.ToLocalTime().ToString("HH:mm")
                        </MudText>

                        <div>
                            <MudText Typo="Typo.body2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                         Class="ma-0 mr-1">@RecordTypeDisplay.Name(e.EntityType)</MudChip>
                                @if (e.RecordDeleted || string.IsNullOrEmpty(e.Href))
                                {
                                    <b>@e.Name</b>
                                    @if (e.RecordDeleted)
                                    {
                                        <span class="mud-text-secondary"> (im Papierkorb)</span>
                                    }
                                }
                                else
                                {
                                    <MudLink Href="@e.Href" Typo="Typo.body2"><b>@e.Name</b></MudLink>
                                }
                                <span class="mud-text-secondary"> · @e.Title</span>
                            </MudText>

                            @if (!string.IsNullOrWhiteSpace(e.Detail))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space:pre-wrap;">@e.Detail</MudText>
                            }

                            @if (e.Changes is { Count: > 0 } changes)
                            {
                                @* one line with separators; the full before/after lives in the change log *@
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @FieldSummary(changes)
                                </MudText>
                            }
                        </div>

                        <MudText Typo="Typo.caption" Class="mud-text-secondary chronik-akteur">
                            @(e.ActorName ?? "System")
                        </MudText>
                    </div>
                }
            </div>
        }
    </MudStack>
}

@code {
    /// <summary>Events to render, any order; grouped and sorted here.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ChronikEvent> Events { get; set; } = Array.Empty<ChronikEvent>();

    /// <summary>Draws a divider before the first event the viewer has already seen; null hides it.</summary>
    [Parameter] public DateTime? LastSeenUtc { get; set; }

    private const int MaxChanges = 4;

    private static string FieldSummary(IReadOnlyList<AuditDisplay.FieldChange> changes)
    {
        var shown = changes.Take(MaxChanges).Select(c => $"{c.Field}: {c.Alt} → {c.New}");
        var text = string.Join("  ·  ", shown);
        return changes.Count > MaxChanges
            ? $"{text}  ·  … {changes.Count - MaxChanges} weitere"
            : text;
    }

    // index of the first already-seen event, or -1 when the marker would sit at the very top or bottom
    private int FirstOlderIndex()
    {
        if (LastSeenUtc is not { } seen)
        {
            return -1;
        }
        var ordered = Events.OrderByDescending(e => e.Timestamp).ToList();
        var index = ordered.FindIndex(e => e.Timestamp <= seen);
        return index <= 0 ? -1 : index;
    }

    private static string DayLabel(DateTime localDay)
    {
        var today = DateTime.Now.Date;
        if (localDay == today)
        {
            return $"Heute, {localDay:dd.MM.yyyy}";
        }
        if (localDay == today.AddDays(-1))
        {
            return $"Gestern, {localDay:dd.MM.yyyy}";
        }
        return localDay.ToString("dddd, dd.MM.yyyy");
    }
}
