@* Clearing: books the whole on-hand of every ticked item down to zero. *@
@inject IEvidenceService Evidence
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:520px;">
            @if (_load)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_all.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    Die Kammer ist bereits leer — kein Item hat einen Bestand ungleich 0.
                </MudAlert>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Von jedem angehakten Item wird der komplette Bestand auf 0 gebucht — als Herausnahme
                    auf die NOOSE. Die Items selbst bleiben im Katalog erhalten.
                </MudText>

                @if (_negativeCount > 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined"
                              Icon="@Icons.Material.Filled.MoveToInbox">
                        @_negativeCount @(_negativeCount == 1 ? "Item hat" : "Items haben") einen negativen Bestand.
                        Davon wird nichts entnommen — sie werden per Einlagerung auf 0 <b>korrigiert</b>.
                    </MudAlert>
                }

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudTextField T="string" Value="_filter" ValueChanged="FilterChanged" Immediate="true"
                                  DebounceInterval="200" Placeholder="Item filtern…"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                  Class="flex-grow-1" Disabled="_busy" />
                    <MudSelect T="string" Value="_category" ValueChanged="CategoryChanged" Clearable="true" Dense="true"
                               Placeholder="Alle Kategorien" Margin="Margin.Dense" Disabled="_busy"
                               ToStringFunc="@(c => c is null ? string.Empty : EvidenceCategories.Label(c))"
                               Style="min-width:180px;max-width:220px" Variant="Variant.Outlined">
                        @foreach (var c in _categories)
                        {
                            <MudSelectItem T="string" Value="@c">@c</MudSelectItem>
                        }
                        @if (_hasUncategorised)
                        {
                            <MudSelectItem T="string" Value="@EvidenceCategories.None">Ohne Kategorie</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.DoneAll" OnClick="SelectAllVisible">Alle</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" OnClick="SelectNoneVisible">Keine</MudButton>
                </MudStack>

                @if (HasFilter)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        „Alle“ und „Keine“ wirken nur auf die @_visible.Count gefilterten Zeilen.
                        @if (_category is not null)
                        {
                            <text>Die Kategorie begrenzt die Buchung — ausgeblendete Items werden nicht gebucht.</text>
                        }
                    </MudText>
                }

                <MudPaper Class="pa-2" Outlined="true" Style="max-height:340px; overflow-y:auto;">
                    @if (_visible.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary pa-2">Kein Treffer.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="0">
                            @foreach (var row in _visible)
                            {
                                <MudCheckBox T="bool" Dense="true" Disabled="_busy"
                                             Color="@(row.OnHand < 0 ? Color.Warning : Color.Primary)"
                                             Value="@_selected.Contains(row.Item.Id)"
                                             ValueChanged="@(_ => Toggle(row.Item.Id))">
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudText Typo="Typo.body2">@row.Item.Name</MudText>
                                        @if (!string.IsNullOrWhiteSpace(row.Item.Category))
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                                @row.Item.Category
                                            </MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 Color="@(row.OnHand < 0 ? Color.Error : Color.Success)">
                                            Bestand: @row.OnHand
                                        </MudChip>
                                        @if (row.OnHand < 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                                     Icon="@Icons.Material.Filled.MoveToInbox">
                                                Korrektur +@(-row.OnHand)
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudCheckBox>
                            }
                        </MudStack>
                    }
                </MudPaper>

                <MudDivider />

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                             Icon="@Icons.Material.Filled.Outbox">
                        @TakeItems entnehmen · @TakePieces Stück
                    </MudChip>
                    @if (FixItems > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.MoveToInbox">
                            @FixItems korrigieren · +@FixPieces Stück
                        </MudChip>
                    }
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_selected.Count von @_all.Count ausgewählt
                    </MudText>
                </MudStack>

                <MentionInput Text="@(_notes ?? string.Empty)" TextChanged="@(v => _notes = v)"
                              Label="Notiz (optional)" Lines="2" Disabled="_busy"
                              Placeholder="z. B. Abtransport durch den Dienstleister"
                              HelperText="@MentionInput.Hint" />

                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Die erzeugten Einträge stehen danach unter „Einträge“. Werden sie gelöscht, wird der
                    Bestand wieder gutgeschrieben.
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Abbrechen</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="ApplyAsync"
                   Disabled="@(_busy || _selected.Count == 0)"
                   StartIcon="@Icons.Material.Filled.Outbox">
            @(_busy ? "Wird gebucht…" : "Bestand auf 0 buchen")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    /// <summary>Item ids ticked on open; null ticks everything the category filter leaves visible.</summary>
    [Parameter] public IReadOnlyCollection<string>? PreselectedItemIds { get; set; }

    /// <summary>Category the dialog opens filtered to; null shows every category.</summary>
    [Parameter] public string? InitialCategory { get; set; }

    private bool _load = true;
    private bool _busy;
    private string? _filter;
    private string? _category;
    private string? _notes;
    private int _negativeCount;
    private bool _hasUncategorised;

    private List<EvidenceItemDisplay> _all = new();
    private List<EvidenceItemDisplay> _visible = new();
    private List<string> _categories = new();
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);

    private bool HasFilter => !string.IsNullOrWhiteSpace(_filter) || _category is not null;

    private IEnumerable<EvidenceItemDisplay> Picked => _all.Where(r => _selected.Contains(r.Item.Id));
    private int TakeItems => Picked.Count(r => r.OnHand > 0);
    private int TakePieces => Picked.Where(r => r.OnHand > 0).Sum(r => r.OnHand);
    private int FixItems => Picked.Count(r => r.OnHand < 0);
    private int FixPieces => Picked.Where(r => r.OnHand < 0).Sum(r => -r.OnHand);

    protected override async Task OnInitializedAsync()
    {
        // read fresh: the tile grid may be minutes old and is search-filtered
        _all = (await Evidence.GetItemsAsync()).Where(r => r.OnHand != 0).ToList();

        // only categories that actually hold stock belong in this dropdown
        _categories = _all
            .Select(r => r.Item.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c, StringComparer.CurrentCulture)
            .ToList();
        _hasUncategorised = _all.Any(r => string.IsNullOrWhiteSpace(r.Item.Category));
        _category = InitialCategory;
        // keep the incoming filter selectable even when nothing of it holds stock
        if (_category is not null && !EvidenceCategories.IsNone(_category)
            && !_categories.Contains(_category, StringComparer.OrdinalIgnoreCase))
        {
            _categories.Add(_category);
            _categories.Sort(StringComparer.CurrentCulture);
        }
        _hasUncategorised |= EvidenceCategories.IsNone(_category);

        Recompute();
        // an explicit pick may name zero-stock rows this dialog never loads, so keep _selected inside _all
        var preselect = (PreselectedItemIds ?? _visible.Select(r => r.Item.Id).ToList())
            .ToHashSet(StringComparer.Ordinal);
        foreach (var row in _all)
        {
            if (preselect.Contains(row.Item.Id))
            {
                _selected.Add(row.Item.Id);
            }
        }
        _load = false;
    }

    private void FilterChanged(string? value)
    {
        _filter = value;
        Recompute();
    }

    private void CategoryChanged(string? value)
    {
        _category = value;
        Recompute();
        // the booking must never contain what the category hides, so the selection only ever shrinks
        var inScope = InCategory(_all).Select(r => r.Item.Id).ToHashSet(StringComparer.Ordinal);
        _selected.RemoveWhere(id => !inScope.Contains(id));
    }

    private void Recompute()
    {
        var scoped = InCategory(_all).ToList();
        // the hint must describe the booking scope, which the text filter does not narrow
        _negativeCount = scoped.Count(r => r.OnHand < 0);
        IEnumerable<EvidenceItemDisplay> rows = scoped;
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            var needle = _filter.Trim();
            rows = rows.Where(r => r.Item.Name.Contains(needle, StringComparison.OrdinalIgnoreCase));
        }
        _visible = rows.ToList();
    }

    /// <summary>Category scope of the booking; the text filter only narrows what is shown.</summary>
    private IEnumerable<EvidenceItemDisplay> InCategory(IEnumerable<EvidenceItemDisplay> rows)
        => _category is null
            ? rows
            : rows.Where(r => EvidenceCategories.Matches(r.Item.Category, _category));

    private void Toggle(string itemId)
    {
        if (!_selected.Remove(itemId))
        {
            _selected.Add(itemId);
        }
    }

    private void SelectAllVisible()
    {
        foreach (var row in _visible)
        {
            _selected.Add(row.Item.Id);
        }
    }

    private void SelectNoneVisible()
    {
        foreach (var row in _visible)
        {
            _selected.Remove(row.Item.Id);
        }
    }

    private async Task ApplyAsync()
    {
        if (_busy || _selected.Count == 0)
        {
            return;
        }
        _busy = true;
        try
        {
            var result = await Evidence.ClearStockAsync(_selected.ToList(), _notes.TrimToNull(), User);
            // the caller must not name its own filter: the dialog's scope may have moved since it opened
            MudDialog.Close(DialogResult.Ok(new Outcome(result, _category)));
        }
        catch (Exception ex)
        {
            // stay open so a long unticking session survives a failed booking
            Snackbar.Add(ex.Message, Severity.Error);
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>Booking outcome plus the category it was booked under; a null category means no scope.</summary>
    public record Outcome(EvidenceClearingResult Result, string? Category);

    /// <summary>Opens the clearing dialog; returns the booking outcome or null if cancelled.</summary>
    public static async Task<Outcome?> ShowAsync(IDialogService dialog, ClaimsPrincipal user,
        IReadOnlyCollection<string>? preselectedItemIds = null, string? initialCategory = null)
    {
        var parameters = new DialogParameters<EvidenceClearingDialog>
        {
            { x => x.User, user },
            { x => x.PreselectedItemIds, preselectedItemIds },
            { x => x.InitialCategory, initialCategory },
        };
        var reference = await dialog.ShowAsync<EvidenceClearingDialog>("Kammer räumen", parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseOnEscapeKey = true,
                BackdropClick = false,
            });
        var result = await reference.Result;
        return result is { Canceled: false, Data: Outcome outcome } ? outcome : null;
    }
}
