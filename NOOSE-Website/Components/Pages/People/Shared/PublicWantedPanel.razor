@* Public wanted notice of this file: create, edit and publish the snapshot that goes outside. *@
@using System.Security.Claims
@using NOOSE_Website.Models.Public
@using NOOSE_Website.Services.Public
@inject IPublicWantedService Wanted
@inject ISnackbar Snackbar

@* no MudPaper of its own: RecordSectionRail already hands the section a padded surface, and a card in a card
   was one nesting level of pure noise *@
@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_row is null)
{
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Für diese Akte gibt es keine öffentliche Ausschreibung.
            </MudText>
            <MudSpacer />
            <MudButton Href="/fahndung?tab=oeffentlich" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.List">Alle Ausschreibungen</MudButton>
        </MudStack>
        @* spelled out here, where there is no header to hang the tooltip on *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@SnapshotHint</MudText>
        @if (_mayWrite)
        {
            <div>
                <MudButton OnClick="CreateAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Add">Ausschreibung anlegen</MudButton>
            </div>
        }
    </MudStack>
}
else
{
    @* every internal agent may open the notice of a file he can see — a rank 1-2 agent has to, or he could file
       a draft and never reach the request that is the whole point of the rank switch *@
    <PublicWantedEditor Id="@_row.Id" User="User" Changed="ReloadQuietlyAsync" Closed="ReloadQuietlyAsync">
        <HeaderContent>
            @if (_row.Status is PublicWantedStatus.Veroeffentlicht or PublicWantedStatus.Gefasst
                or PublicWantedStatus.Abgelaufen)
            {
                @* the counter is an internal figure and lives on an internal projection, so it cannot reach a public page *@
                <MudTooltip Text="Öffentliche Aufrufe — interne Zahl, sie erreicht keine öffentliche Seite.">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.Visibility">@_row.ViewCount</MudChip>
                </MudTooltip>
            }
            <MudTooltip Text="@SnapshotHint">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="mud-text-secondary" />
            </MudTooltip>
            <MudButton Href="/fahndung?tab=oeffentlich" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.List">Alle Ausschreibungen</MudButton>
        </HeaderContent>
    </PublicWantedEditor>
}

@code {
    [Parameter, EditorRequired] public string PersonId { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Wording of the snapshot rule; unchanged from the paragraph it replaced.</summary>
    private const string SnapshotHint =
        "Was hier steht, ist ein eigener Publikations-Snapshot: spätere Änderungen an der Akte wirken sich erst "
        + "beim nächsten Veröffentlichen aus. Eine Verschlusssache lässt sich nicht ausschreiben.";

    private PublicWantedEdit? _row;
    private bool _load = true;
    private bool _busy;
    private bool _mayWrite;
    private bool _mayOpen;
    private string? _loadedId;

    protected override void OnInitialized()
    {
        _mayWrite = User.MayWrite() && !User.IsCitizen();
        // mirrors Permission.RequirePublicWantedRecordRead; which notices actually resolve is decided by the file
        _mayOpen = !User.IsPartner() && !User.IsCitizen();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == PersonId)
        {
            return;
        }
        _loadedId = PersonId;
        await LoadAsync();
    }

    private Task LoadAsync() => LoadAsync(showSpinner: true);

    private async Task LoadAsync(bool showSpinner)
    {
        if (showSpinner)
        {
            _load = true;
        }
        try
        {
            _row = _mayOpen ? await Wanted.GetForPersonAsync(PersonId, User) : null;
        }
        catch
        {
            /* best effort */
            _row = null;
        }
        finally
        {
            _load = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    /// <summary>Refresh without the spinner; swapping the editor for a progress bar tears it down, and the
    /// rebuilt one starts back on its first tab with the accusation editor unmounted again.</summary>
    private async Task ReloadQuietlyAsync()
    {
        await LoadAsync(showSpinner: false);
        await Changed.InvokeAsync();
    }

    private async Task CreateAsync()
    {
        _busy = true;
        try
        {
            await Wanted.CreateDraftFromPersonAsync(PersonId, User);
            Snackbar.Add("Entwurf angelegt — er ist noch nicht öffentlich.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
