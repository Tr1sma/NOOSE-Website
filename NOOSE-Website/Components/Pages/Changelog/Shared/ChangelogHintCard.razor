@* One-off hint that a new release landed since the agent last looked. Renders nothing the rest of the time. *@
@implements IDisposable
@inject IChangelogService ChangelogService
@inject INavPreferencesService NavPreferences
@inject NavigationManager Nav

@if (_flash is { Count: > 0 } flash)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true"
              Class="mb-4 no-print"
              Icon="@Icons.Material.Filled.NewReleases"
              ShowCloseIcon="true" CloseIconClicked="DismissAsync">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">
                @Wording(flash)
            </MudText>
            <MudButton Href="/neuerungen" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       OnClick="DismissAsync">Ansehen</MudButton>
        </MudStack>
    </MudAlert>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ChangelogNewsFlash? _flash;
    private string? _agentId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        var user = (await AuthState).User;
        // the changelog is an internal page; a partner cannot open it, so do not advertise it either
        if (!user.IsInternalAgent())
        {
            return;
        }

        _agentId = user.GetAgentId();
        if (string.IsNullOrEmpty(_agentId))
        {
            return;
        }

        try
        {
            var prefs = await NavPreferences.GetAsync(_agentId);
            var lastSeen = prefs.NeuerungenLastSeenUtc;

            // never looked: stamp now and stay quiet. Greeting a new agent with the whole history as
            // "new since your last visit" would be both untrue and a wall of text.
            if (lastSeen is null)
            {
                await NavPreferences.SetNeuerungenLastSeenAsync(_agentId, DateTime.UtcNow);
                return;
            }

            _flash = await ChangelogService.GetNewsSinceAsync(lastSeen);
        }
        catch { /* best effort */ }

        Nav.LocationChanged += OnLocationChanged;
    }

    /// <summary>Stands down once the agent is on the page it points at.</summary>
    /// <remarks>
    /// The card lives in the layout, so it survives every internal navigation and never runs its initialiser
    /// again. Opening /neuerungen through the menu rather than through the button therefore left it standing
    /// with "2 Neuerungen seit deinem letzten Besuch" for the rest of the session.
    /// </remarks>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_flash is null)
        {
            return;
        }
        var pfad = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (!string.Equals(pfad, "/neuerungen", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        _ = InvokeAsync(DismissAsync);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private static string Wording(ChangelogNewsFlash flash)
    {
        var count = flash.Count == 1 ? "Eine Neuerung" : $"{flash.Count} Neuerungen";
        return flash.NewestVersion is { } v
            ? $"{count} seit deinem letzten Besuch — Fassung {v} ist da."
            : $"{count} seit deinem letzten Besuch.";
    }

    private async Task DismissAsync()
    {
        _flash = null;
        StateHasChanged();
        if (string.IsNullOrEmpty(_agentId))
        {
            return;
        }
        try
        {
            await NavPreferences.SetNeuerungenLastSeenAsync(_agentId, DateTime.UtcNow);
        }
        catch { /* best effort */ }
    }
}
