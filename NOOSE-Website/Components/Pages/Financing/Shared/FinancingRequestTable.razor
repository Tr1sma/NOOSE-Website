@* Funding requests as a flat table; every row links to its record, where the decisions happen. *@

@if (Rows.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Filled.RequestQuote" Title="@EmptyTitle" Text="@EmptyText" />
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>Aktenzeichen</th>
                @if (ShowAgent)
                {
                    <th>Agent</th>
                }
                <th>Status</th>
                <th>Positionen</th>
                <th style="text-align:right">Beantragt</th>
                <th style="text-align:right">Genehmigt</th>
                <th>Gestellt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                var request = row.Request;
                <tr>
                    <td style="white-space:nowrap">@request.CaseNumber</td>
                    @if (ShowAgent)
                    {
                        <td>@row.AgentCodename</td>
                    }
                    <td>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@FinancingStatusDisplay.ChipColor(request.Status)"
                                 Icon="@FinancingStatusDisplay.Icon(request.Status)">@FinancingStatusDisplay.Name(request.Status)</MudChip>
                    </td>
                    <td>@Summary(request)</td>
                    <td style="text-align:right">@Money.Format(request.RequestedSubsidy)</td>
                    <td style="text-align:right">@(request.ApprovedSubsidy is { } sum ? Money.Format(sum) : "—")</td>
                    <td style="white-space:nowrap">@request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                       Href="@($"/finanzierungen/{request.Id}")" aria-label="Antrag öffnen" />
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FinancingRequestDisplay> Rows { get; set; } = [];

    /// <summary>Shows the requester column; off on the agent's own list, where it is always themselves.</summary>
    [Parameter] public bool ShowAgent { get; set; }

    [Parameter] public string EmptyTitle { get; set; } = "Keine Finanzierungsanträge";
    [Parameter] public string? EmptyText { get; set; }

    private static string Summary(FinancingRequest request)
    {
        if (request.Lines.Count == 0)
        {
            return "—";
        }
        var first = request.Lines[0];
        var head = $"{FinancingMath.EffectiveQuantity(first)}× {first.ItemName}";
        return request.Lines.Count == 1 ? head : $"{head} +{request.Lines.Count - 1}";
    }
}
