@* Commendation or disciplinary notes (rich text); add/delete is leadership-only. *@
@inject IPersonnelFileService PersonnelFileService
@inject IPersonnelTemplateService PersonnelTemplateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudText Typo="Typo.subtitle1">@Title (@_notes.Count)</MudText>

    <AuthorizeView Policy="@Policies.Leadership">
        <MudStack Spacing="2">
            @if (_templates.Count > 0)
            {
                <MudSelect T="string" Value="_selectedTemplateId" ValueChanged="ApplyTemplateAsync" Label="Vorlage einfügen"
                           Variant="Variant.Outlined" Dense="true" Clearable="true" Placeholder="Vorlage wählen …">
                    @foreach (var t in _templates)
                    {
                        <MudSelectItem T="string" Value="@t.Id">@t.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <RichTextEditor @ref="_editor" @bind-Value="_newHtml" MinHeight="200px" />
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddAsync" Disabled="@(_saves || string.IsNullOrWhiteSpace(_newHtml))">Hinzufügen</MudButton>
            </div>
        </MudStack>
    </AuthorizeView>

    @if (_load)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_notes.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Einträge.</MudText>
    }
    else
    {
        @foreach (var v in _notes)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                    <div>
                        @* Sanitized server-side on save, so safe as MarkupString. *@
                        <div class="dokument-html">@((MarkupString)v.Text)</div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(string.IsNullOrWhiteSpace(v.AuthorName) ? "—" : v.AuthorName) · @v.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </div>
                    <AuthorizeView Policy="@Policies.Leadership">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteAsync(v))" aria-label="Eintrag löschen" />
                    </AuthorizeView>
                </MudStack>
            </MudPaper>
        }
    }
</MudStack>

@code {
    [Parameter, EditorRequired] public string AgentId { get; set; } = default!;
    [Parameter, EditorRequired] public AgentNoteKind Kind { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _load = true;
    private bool _saves;
    private string _newHtml = string.Empty;
    private string? _selectedTemplateId;
    private RichTextEditor _editor = default!;
    private ClaimsPrincipal _user = default!;
    private List<AgentNote> _notes = new();
    private List<PersonnelTemplate> _templates = new();

    private string Title => Kind == AgentNoteKind.Commendation ? "Belobigungen" : "Disziplinarisches";

    private PersonnelTemplateKind TemplateKind => Kind == AgentNoteKind.Commendation
        ? PersonnelTemplateKind.Commendation
        : PersonnelTemplateKind.Disciplinary;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthStateTask).User;
        if (_user.IsLeadership())
        {
            _templates = await PersonnelTemplateService.GetActiveAsync(TemplateKind);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        _notes = await PersonnelFileService.GetNotesAsync(AgentId, Kind);
        _load = false;
    }

    private async Task ApplyTemplateAsync(string? id)
    {
        _selectedTemplateId = null;
        if (string.IsNullOrEmpty(id))
        {
            return;
        }
        var t = _templates.FirstOrDefault(x => x.Id == id);
        if (t is null)
        {
            return;
        }
        _newHtml = t.ContentHtml;
        await _editor.SetHtmlAsync(t.ContentHtml);
    }

    private async Task AddAsync()
    {
        if (_saves)
        {
            return;
        }
        var html = await _editor.GetHtmlAsync();
        if (string.IsNullOrWhiteSpace(html))
        {
            return;
        }
        _saves = true;
        try
        {
            await PersonnelFileService.NoteCreateAsync(AgentId, Kind, html, _user);
            _newHtml = string.Empty;
            await _editor.SetHtmlAsync(string.Empty);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        _saves = false;
    }

    private async Task DeleteAsync(AgentNote v)
    {
        var ok = await ConfirmDialog.ShowAsync(DialogService, "Eintrag löschen?", "Der Eintrag wird entfernt.");
        if (!ok)
        {
            return;
        }
        try
        {
            await PersonnelFileService.NoteDeleteAsync(v.Id, _user);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
