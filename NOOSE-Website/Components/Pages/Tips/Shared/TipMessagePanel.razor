@inject ITipService Tips
@inject IPublicTemplateService Templates
@inject TipsBroadcaster Broadcaster
@inject ISnackbar Snackbar
@implements IDisposable

@* one component, two threads. The citizen-facing rows carry no author at all, so nothing has to be hidden here *@
<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@(IsInternal ? Icons.Material.Filled.Lock : Icons.Material.Filled.Forum)"
                     Color="@(IsInternal ? Color.Warning : Color.Primary)" Size="Size.Small" />
            <MudText Typo="Typo.h6">@(IsInternal ? "Interne Notizen" : "Schriftwechsel mit dem Hinweisgeber")</MudText>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @(IsInternal
                ? "Nur für Agenten sichtbar."
                : "Der Hinweisgeber sieht diese Zeilen als Nachricht von „NOOSE“ — nie mit Codename.")
        </MudText>

        @if (_load)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_messages.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Noch keine Nachricht.</MudText>
        }
        else
        {
            <MudStack Spacing="2" Style="max-height:420px;overflow-y:auto;">
                @foreach (var message in _messages)
                {
                    <MudPaper Outlined="true" Class="pa-3"
                              Style="@(message.FromCitizen ? "margin-right:12%;" : "margin-left:12%;")">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Color="@(message.FromCitizen ? Color.Default : Color.Primary)">
                                @Author(message) · @message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@message.Text</MudText>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }

        @if (CanWrite)
        {
            <MudTextField @bind-Value="_draft" Label="@(IsInternal ? "Notiz" : "Nachricht an den Hinweisgeber")"
                          Lines="3" Variant="Variant.Outlined" MaxLength="@TipRules.MaxMessageLength" />
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton OnClick="SendAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send">
                    @(IsInternal ? "Notiz speichern" : "Senden")
                </MudButton>
                @* the template only fills the field; sending stays a deliberate act *@
                @if (_templates.Count > 0)
                {
                    <MudMenu Label="Vorlage" Variant="Variant.Outlined" Size="Size.Small"
                             EndIcon="@Icons.Material.Filled.ArrowDropDown">
                        @foreach (var template in _templates)
                        {
                            <MudMenuItem OnClick="@(() => Apply(template))">
                                @PublicTemplateKindDisplay.Name(template.Kind) · @template.Title
                            </MudMenuItem>
                        }
                    </MudMenu>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    [EditorRequired]
    public string TipId { get; set; } = string.Empty;

    [Parameter]
    [EditorRequired]
    public ClaimsPrincipal User { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public TipMessageAudience Audience { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Fills the AKTENZEICHEN token of a picked template.</summary>
    [Parameter]
    public string? CaseNumber { get; set; }

    /// <summary>Fills the BUERGER token; null while the anonymity promise holds, and then the salutation falls back.</summary>
    [Parameter]
    public string? CitizenName { get; set; }

    private IReadOnlyList<TipMessageRow> _messages = Array.Empty<TipMessageRow>();
    private IReadOnlyList<PublicTemplateRow> _templates = Array.Empty<PublicTemplateRow>();
    private bool _templatesLoaded;
    private string _draft = string.Empty;
    private bool _load = true;
    private bool _busy;
    private string? _loadedId;

    private bool IsInternal => Audience == TipMessageAudience.Intern;

    protected override void OnInitialized() => Broadcaster.Modified += OnModified;

    protected override async Task OnParametersSetAsync()
    {
        // before the id guard: CanWrite turns true only when a closed tip moves back, and the guard would then
        // skip the template load for the life of the component
        await LoadTemplatesAsync();
        if (_loadedId == TipId)
        {
            return;
        }
        _loadedId = TipId;
        await LoadAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        if (_templatesLoaded || IsInternal || !CanWrite)
        {
            return;
        }
        _templatesLoaded = true;
        // both kinds land in one menu: asking back and turning down are the same field
        try
        {
            var follow = await Templates.GetActiveAsync(PublicTemplateKind.HinweisRueckfrage);
            var refuse = await Templates.GetActiveAsync(PublicTemplateKind.HinweisAblehnung);
            _templates = follow.Concat(refuse).ToList();
        }
        catch { /* ignore */ }
    }

    private void Apply(PublicTemplateRow template)
        => _draft = PublicTemplateRenderer.Render(template.Text, new PublicTemplateContext(CitizenName, CaseNumber));

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _messages = await Tips.GetMessagesAsync(TipId, Audience, User);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _load = false;
        }
    }

    private async Task SendAsync()
    {
        _busy = true;
        try
        {
            if (IsInternal)
            {
                await Tips.PostInternalNoteAsync(TipId, _draft, User);
            }
            else
            {
                await Tips.AskCitizenAsync(TipId, _draft, User);
            }
            _draft = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // the projection is the gate: TipDetail.CitizenName stays null while the anonymity promise holds, so a name
    // here can only be one the leadership already resolved
    private string Author(TipMessageRow message)
    {
        if (message.FromCitizen)
        {
            return IsInternal ? CitizenName ?? "Hinweisgeber" : "Hinweisgeber";
        }
        return IsInternal ? message.AuthorCodename ?? "NOOSE" : "NOOSE";
    }

    private void OnModified(string tipId)
    {
        if (tipId != TipId)
        {
            return;
        }
        InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    public void Dispose() => Broadcaster.Modified -= OnModified;
}
