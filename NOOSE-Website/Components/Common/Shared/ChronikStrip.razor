@* Activity density band (vis-timeline Graph2d bars). Presentational: takes buckets, raises the picked range. *@
@using System.Text.Json
@using NOOSE_Website.Models.Timeline
@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@_containerId" class="chronik-band" style="width:100%;height:110px;"></div>
@if (_loadError)
{
    <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">Übersichtsband konnte nicht geladen werden.</MudText>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ChronikDensityBucket> Buckets { get; set; } = Array.Empty<ChronikDensityBucket>();
    [Parameter, EditorRequired] public DateTime WindowStartUtc { get; set; }
    [Parameter, EditorRequired] public DateTime WindowEndUtc { get; set; }
    [Parameter] public EventCallback<(DateTime From, DateTime To)> OnRangeChanged { get; set; }

    private readonly string _containerId = "chronik-band-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChronikStrip>? _ref;
    private bool _ready;
    private bool _loadError;
    private string _lastJson = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chronik.js?v=2");
            _ref = DotNetObjectReference.Create(this);
            _lastJson = BuildJson();
            await _module.InvokeVoidAsync("render", _containerId, _lastJson, _ref);
            _ready = true;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* ignore */ }
        catch
        {
            _loadError = true;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready || _module is null)
        {
            return;
        }
        var json = BuildJson();
        if (json == _lastJson)
        {
            return; // panning inside the band must not re-push the same bars
        }
        _lastJson = json;
        try
        {
            await _module.InvokeVoidAsync("setItems", _containerId, json);
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* ignore */ }
        catch { /* best effort */ }
    }

    [JSInvokable]
    public async Task OnRangeChangedJs(string fromIso, string toIso)
    {
        if (!OnRangeChanged.HasDelegate
            || !DateTime.TryParse(fromIso, null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var from)
            || !DateTime.TryParse(toIso, null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var to))
        {
            return;
        }
        await InvokeAsync(() => OnRangeChanged.InvokeAsync((from, to)));
    }

    private string BuildJson()
    {
        var buckets = Buckets
            .Select(b => new { start = b.StartUtc.ToLocalTime().ToString("s"), count = b.Count })
            .ToList();
        var barWidth = buckets.Count == 0 ? 18 : Math.Clamp(900 / buckets.Count, 3, 26);
        return JsonSerializer.Serialize(new
        {
            buckets,
            barWidth,
            windowStart = WindowStartUtc.ToLocalTime().ToString("s"),
            windowEnd = WindowEndUtc.ToLocalTime().ToString("s"),
        });
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("destroy", _containerId);
                await _module.DisposeAsync();
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* ignore */ }
        catch { /* best effort */ }
        _ref?.Dispose();
    }
}
