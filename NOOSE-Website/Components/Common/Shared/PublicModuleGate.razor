@inject IPublicModuleService ModuleService

@* Renders a public module's content, or its offline notice while the module (or the whole area) is off. *@
@if (_loaded)
{
    @if (_enabled)
    {
        @ChildContent
    }
    else
    {
        @* A switched-off module is not "a page with a notice", it is gone: the route answers 404 (set below) and
           carries noindex, so a known URL cannot reach it and the notice never enters an index. The body still
           explains why, because StatusCodePagesWithReExecute only re-executes a response that has none. *@
        <HeadContent>
            <meta name="robots" content="noindex, nofollow" />
        </HeadContent>
        <MudPaper Elevation="4" Class="pa-4 pa-sm-8">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.DoNotDisturbOn" Color="Color.Default" Size="Size.Large" />
                <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Title) ? "Nicht verfügbar" : Title)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="text-align:center;max-width:520px;">
                    @_offlineText
                </MudText>
                <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Home">Zur Startseite</MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    // The gate is the page's own check, not a nav decoration: a visitor who knows the URL of a module that was
    // switched off reaches the route, so the route itself has to answer.
    [Parameter, EditorRequired]
    public string Module { get; set; } = string.Empty;

    /// <summary>Heading of the offline notice; the page title is usually the right value.</summary>
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Present during static rendering, null once a page runs interactively.</summary>
    [CascadingParameter]
    private HttpContext? PageContext { get; set; }

    private bool _loaded;
    private bool _enabled;
    private string _offlineText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapshot = await ModuleService.GetAsync();
            _enabled = snapshot.IsEnabled(Module);
            var text = snapshot.Find(Module)?.OfflineText;
            _offlineText = string.IsNullOrWhiteSpace(text) ? "Dieser Bereich ist derzeit nicht verfügbar." : text;
        }
        catch
        {
            /* best effort */
            _offlineText = "Dieser Bereich ist derzeit nicht verfügbar.";
        }

        // A URL into a switched-off module answers 404, not 200: a module that is off is indistinguishable from a
        // page that does not exist, which is also the honest answer to "which modules does this site have".
        // Consequence, deliberate: Routes.razor sets Router.NotFoundPage, so the router renders NotFound.razor
        // instead of the notice below - the offline text reaches a visitor only on an interactive page, where
        // there is no HttpContext to carry a status code.
        if (!_enabled && PageContext is { } http && !http.Response.HasStarted)
        {
            http.Response.StatusCode = StatusCodes.Status404NotFound;
        }
        _loaded = true;
    }
}
