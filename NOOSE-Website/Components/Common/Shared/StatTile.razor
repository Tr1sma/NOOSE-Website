@* Dashboard KPI tile; navigates to the matching list when Href is set. *@
@inject NavigationManager Nav

<MudPaper Class="@PaperClass" Elevation="2" @onclick="Activate" role="@(Href is null ? null : "link")"
          tabindex="@(Href is null ? null : "0")" @onkeydown="OnKeyDown" title="@Hint">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icon" Color="@Colour" />
        <MudText Typo="Typo.overline" Class="mud-text-secondary">@Label</MudText>
    </MudStack>
    <MudText Typo="Typo.h4" Class="mt-2">@Value</MudText>
</MudPaper>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Numbers;
    [Parameter] public Color Colour { get; set; } = Color.Primary;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "…";

    /// <summary>Target list; makes the whole tile clickable.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Native tooltip explaining what the number counts.</summary>
    [Parameter] public string? Hint { get; set; }

    private string PaperClass => Href is null ? "pa-4" : "pa-4 cursor-pointer";

    private void Activate()
    {
        if (!string.IsNullOrEmpty(Href))
        {
            Nav.NavigateTo(Href);
        }
    }

    // keyboard parity for the click handler
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            Activate();
        }
    }
}
