@* Command palette (Ctrl+K); hotkey registered via JS interop. *@
@using NOOSE_Website.Navigation
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISearchService SearchService
@inject INavPreferencesService NavPrefs
@inject IPartnerVisibilityPolicyService PartnerPolicy
@inject IAuthorizationService Authorization
@inject ITrashService Trash
@inject Microsoft.Extensions.Logging.ILogger<CommandPalette> Logger
@implements IAsyncDisposable

<MudDialog @bind-Visible="_open" Options="_options">
    <TitleContent>
        <MudText Typo="Typo.subtitle1">
            <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Class="mr-1" />Schnellzugriff
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAutocomplete T="PaletteItem" @ref="_auto" SearchFunc="Search" ToStringFunc="@(i => i?.Label ?? string.Empty)"
                         ValueChanged="SelectedAsync" Placeholder="Akte suchen oder Befehl wählen…"
                         Variant="Variant.Outlined" MinCharacters="0" Immediate="true" Clearable="true"
                         ResetValueOnEmptyText="true" AutoFocus="true"
                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
            <ItemTemplate Context="i">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@i.Icon" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">@i.Label</MudText>
                    @if (!string.IsNullOrEmpty(i.Sub))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@i.Sub</MudText>
                    }
                </MudStack>
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">Keine Treffer.</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">Strg+K öffnet diesen Schnellzugriff überall.</MudText>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _open;
    private bool _mayUseNoosei;
    private ClaimsPrincipal? _user;
    private string? _agentId;
    private MudAutocomplete<PaletteItem> _auto = default!;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _ref;
    private readonly DialogOptions _options = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
    private List<PaletteItem> _commands = new();
    private List<PaletteItem> _favorites = new();
    private List<PaletteItem> _recents = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _user = user;
        _agentId = user.GetAgentId();
        // same three exclusions Permission.RequireLlmUse enforces; no point offering an entry that would refuse
        _mayUseNoosei = !user.IsPartner() && !user.IsDemo() && !user.IsOnlyReader();
        if (user.IsPartner())
        {
            // partners: only the record types their rank may see, plus global search
            var allowed = await PartnerPolicy.GetAllowedTypesAsync(user);
            _commands = NavCatalog.PartnerRecordEntries(allowed)
                .Select(e => new PaletteItem(e.Label, e.Description, e.Icon, e.Route))
                .ToList();
            _commands.Add(new PaletteItem("Globale Suche", null, Icons.Material.Filled.Search, "/suche"));
            return;
        }

        // Catalog-driven and gated by the drawer's own section policies, so the palette can never
        // surface an entry the drawer hides. The drawer nests the Verwaltung policies; evaluating
        // them flat here is equivalent because AdminPage ⊆ LeadershipPage ⊆ HighestClassificationPage.
        _commands = new List<PaletteItem>();
        foreach (var section in NavSectionPolicy.InternalSections)
        {
            if (!await AllowedAsync(user, section))
            {
                continue;
            }
            _commands.AddRange(NavCatalog.Section(section)
                .Select(e => new PaletteItem(e.Label, e.Description, e.Icon, e.Route)));
        }

        // creating is barred for read-only supervision and demo accounts
        if (user.MayWrite())
        {
            foreach (var (label, route) in CreateCommands)
            {
                _commands.Add(new PaletteItem(label, "Neu anlegen", Icons.Material.Filled.Add, route));
            }
        }

        // the trash page opens for read-only supervision too, hence the page policy and not IsLeadership
        if ((await Authorization.AuthorizeAsync(user, Policies.LeadershipPage)).Succeeded)
        {
            foreach (var kind in Trash.Kinds)
            {
                _commands.Add(new PaletteItem($"Papierkorb · {kind.Label}", null, Icons.Material.Filled.Delete, $"/papierkorb?tab={kind.Key}"));
            }
        }
    }

    private async Task<bool> AllowedAsync(ClaimsPrincipal user, NavSection section)
        => (await Authorization.AuthorizeAsync(user, NavSectionPolicy.For(section))).Succeeded;

    // record types that can be created straight from the palette; also drives the trash commands
    private static readonly (string Label, string Route)[] CreateCommands =
    {
        ("Personen-Akte", "/personen/neu"),
        ("Fraktion", "/fraktionen/neu"),
        ("Personengruppe", "/personengruppen/neu"),
        ("Partei", "/parteien/neu"),
        ("Operation", "/operationen/neu"),
        ("Taskforce", "/taskforces/neu"),
        ("Vorgang", "/vorgaenge/neu"),
        ("Aufgabe", "/aufgaben/neu"),
        ("Dokument", "/dokumente/neu"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./app.js?v=2");
            _ref = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerCommandPalette", _ref);
        }
    }

    [JSInvokable]
    public async Task Open()
    {
        await LoadQuickAccessAsync();
        _open = true;
        await InvokeAsync(StateHasChanged);
    }

    // refresh favorites + recents each time the palette opens
    private async Task LoadQuickAccessAsync()
    {
        if (string.IsNullOrEmpty(_agentId))
        {
            return;
        }
        try
        {
            var prefs = await NavPrefs.GetAsync(_agentId);
            _favorites = prefs.Favorites.Select(f => new PaletteItem(f.Label, "Favorit", f.Icon, f.Route)).ToList();
            var favRoutes = prefs.Favorites.Select(f => f.Route).ToHashSet(StringComparer.Ordinal);
            _recents = prefs.Recents
                .Where(r => !favRoutes.Contains(r.Route))
                .Take(8)
                .Select(r => new PaletteItem(r.Label, "Zuletzt", r.Icon, r.Route))
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Favoriten/Verlauf für die Command-Palette konnten nicht geladen werden.");
        }
    }

    private async Task<IEnumerable<PaletteItem>> Search(string value, CancellationToken token)
    {
        var v = value?.Trim() ?? string.Empty;
        var result = new List<PaletteItem>();
        if (string.IsNullOrEmpty(v))
        {
            // empty query: favorites and recents first, then the command list
            result.AddRange(_favorites);
            result.AddRange(_recents);
            result.AddRange(_commands);
        }
        else
        {
            result.AddRange(_favorites.Where(b => b.Label.Contains(v, StringComparison.OrdinalIgnoreCase)));
            result.AddRange(_commands.Where(b => b.Label.Contains(v, StringComparison.OrdinalIgnoreCase)));
        }

        if (!string.IsNullOrEmpty(v) && _user is not null)
        {
            try
            {
                var hit = await SearchService.QuickSearchAsync(v, _user, 8, token);
                // a category without a route cannot be a palette entry; dropping beats guessing a wrong record
                result.AddRange(hit
                    .Select(t => new { t.Name, t.CaseNumber, t.Category, Url = SearchNavigation.For(t.Category, t.TargetId) })
                    .Where(t => t.Url is not null)
                    .Select(t => new PaletteItem(t.Name, t.CaseNumber, PaletteIcon(t.Category), t.Url!)));
            }
            catch (Exception ex)
            {
                // fall back to static commands on search failure
                Logger.LogDebug(ex, "Schnellsuche in der Command-Palette fehlgeschlagen.");
            }

            // last, so it never pushes a real hit out of sight; the chat only pre-fills the question
            if (_mayUseNoosei)
            {
                result.Add(new PaletteItem($"NOOSEI fragen: {v}", null, Icons.Material.Filled.SmartToy,
                    "/ki-assistent?frage=" + Uri.EscapeDataString(v)));
            }
        }
        return result;
    }

    private async Task SelectedAsync(PaletteItem? item)
    {
        if (item is null)
        {
            return;
        }
        _open = false;
        await _auto.ClearAsync();
        Nav.NavigateTo(item.Url);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unregisterCommandPalette");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        _ref?.Dispose();
    }

    private static string PaletteIcon(string category) => category switch
    {
        nameof(Faction) => Icons.Material.Filled.Groups,
        nameof(PersonGroup) => Icons.Material.Filled.Diversity3,
        nameof(Party) => Icons.Material.Filled.AccountBalance,
        nameof(Operation) => Icons.Material.Filled.Radar,
        nameof(Taskforce) => Icons.Material.Filled.Groups2,
        nameof(Case) => Icons.Material.Filled.FolderSpecial,
        nameof(Job) => Icons.Material.Filled.AssignmentTurnedIn,
        _ => Icons.Material.Filled.Badge,
    };

    private record PaletteItem(string Label, string? Sub, string Icon, string Url);
}
