@* Renders stored WYSIWYG HTML and resolves its @-mention tokens for the viewer. *@
@inject IMentionService MentionService

<div class="@($"dokument-html {Class}")">@((MarkupString)(_rendered ?? Html ?? string.Empty))</div>

@code {
    /// <summary>Sanitized on save, so it is safe as MarkupString.</summary>
    [Parameter] public string? Html { get; set; }

    /// <summary>Viewer; falls back to the cascading authentication state.</summary>
    [Parameter] public ClaimsPrincipal? User { get; set; }

    /// <summary>Renders mentions as bare text instead of links; for print views.</summary>
    [Parameter] public bool Plain { get; set; }

    [Parameter] public string? Class { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _rendered;
    private string? _source;
    private bool _touched;

    protected override async Task OnParametersSetAsync()
    {
        if (_touched && _source == Html)
        {
            return;
        }
        _touched = true;
        _source = Html;
        _rendered = null;

        // no token -> render raw, no service call
        if (MentionHtml.Refs(Html).Count == 0)
        {
            return;
        }

        var user = User;
        if (user is null && AuthStateTask is not null)
        {
            user = (await AuthStateTask).User;
        }
        if (user is null)
        {
            return;
        }
        _rendered = await MentionService.ResolveHtmlAsync(Html, user.MayClassifiedRead(), user.GetAgentId(),
            partnerAgency: user.GetPartnerAgency(), plain: Plain);
    }
}
