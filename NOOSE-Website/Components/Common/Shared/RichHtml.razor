@* Renders stored WYSIWYG HTML, resolves its @-mention tokens and marks glossary terms for the viewer. *@
@inject IMentionService MentionService
@inject IHandbookService HandbookService
@inject INavPreferencesService NavPrefs

<div class="@($"dokument-html {Class}")">@((MarkupString)(_rendered ?? Html ?? string.Empty))</div>

@code {
    /// <summary>Sanitized on save, so it is safe as MarkupString.</summary>
    [Parameter] public string? Html { get; set; }

    /// <summary>Viewer; falls back to the cascading authentication state.</summary>
    [Parameter] public ClaimsPrincipal? User { get; set; }

    /// <summary>Renders mentions as bare text instead of links, and drops the bubbles; for print views.</summary>
    [Parameter] public bool Plain { get; set; }

    /// <summary>Set false where a glossary bubble would explain the very text it sits in.</summary>
    [Parameter] public bool Glossary { get; set; } = true;

    [Parameter] public string? Class { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string? _rendered;
    private string? _source;
    private bool _plain;
    private bool _glossary = true;
    private bool _touched;

    protected override async Task OnParametersSetAsync()
    {
        // the memo has to key on every input, not just the html: toggling Plain alone changes the output
        if (_touched && _source == Html && _plain == Plain && _glossary == Glossary)
        {
            return;
        }
        _touched = true;
        _source = Html;
        _plain = Plain;
        _glossary = Glossary;
        _rendered = null;

        var user = User;
        if (user is null && AuthStateTask is not null)
        {
            user = (await AuthStateTask).User;
        }

        var html = Html;

        // mentions first. The other way round, the glossary would split a text node while the token
        // @{Typ:GUID} is still raw text, and the mention parser reads one node's data with absolute offsets.
        if (user is not null && MentionHtml.Refs(html).Count > 0)
        {
            html = await MentionService.ResolveHtmlAsync(html, user.MayClassifiedRead(), user.GetAgentId(),
                partnerAgency: user.GetPartnerAgency(), plain: Plain);
        }

        // an empty block asks nothing of the glossary, and a page can hold twenty of them
        if (!string.IsNullOrWhiteSpace(html) && await BubblesOnAsync(user))
        {
            try
            {
                html = GlossaryHtml.Annotate(html, await HandbookService.GetGlossaryMatcherAsync());
            }
            catch
            {
                /* best effort */
            }
        }

        _rendered = html;
    }

    /// <summary>Internal agents only, never in print, and only while the agent leaves them switched on.</summary>
    private async Task<bool> BubblesOnAsync(ClaimsPrincipal? user)
    {
        // an applicant chat and a partner view are rendered through this component too; neither should
        // pick up in-house vocabulary
        if (Plain || !Glossary || user is null || !user.IsInternalAgent())
        {
            return false;
        }
        if (user.GetAgentId() is not { Length: > 0 } agentId)
        {
            return false;
        }
        try
        {
            return (await NavPrefs.GetAsync(agentId)).GlossarBlasen;
        }
        catch
        {
            /* best effort */
            return false;
        }
    }
}
