@* One public wanted notice: snapshot fields, accusation, and the publish/retract actions. Shared by the file page and the management list. *@
@using System.Security.Claims
@using NOOSE_Website.Data.Entities.Public
@using NOOSE_Website.Models.Public
@using NOOSE_Website.Services.Public
@inject IPublicWantedService Wanted
@inject IWarnhinweisService Warnings
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@if (_load)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_draft is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        Die Ausschreibung wurde nicht gefunden.
    </MudAlert>
}
else
{
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="@StatusColour(_draft.Status)" Variant="Variant.Filled">
                @PublicWantedStatusDisplay.Name(_draft.Status)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                @PublicWantedKindDisplay.Name(_draft.Kind)
            </MudChip>
            @if (!string.IsNullOrWhiteSpace(_draft.CaseNumber))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@_draft.CaseNumber</MudChip>
                @if (_draft.Status == PublicWantedStatus.Veroeffentlicht)
                {
                    <MudButton Href="@($"/gesucht/{_draft.CaseNumber}")" Target="_blank" Variant="Variant.Text"
                               Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.OpenInNew">Öffentliche Seite</MudButton>
                }
            }
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="6">
                @* MaxLength, because the service cuts silently: without it a shortened name reaches the poster *@
                <MudTextField @bind-Value="_input.DisplayName" Label="@NameLabel" Variant="Variant.Outlined"
                              MaxLength="@PublicWantedRules.MaxDisplayName"
                              Counter="@PublicWantedRules.MaxDisplayName"
                              Required="true" RequiredError="Anzeigename ist erforderlich" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_input.AliasText" Label="@AliasLabel" Variant="Variant.Outlined"
                              MaxLength="@PublicWantedRules.MaxAliasText"
                              Counter="@PublicWantedRules.MaxAliasText"
                              HelperText="Nur was nach außen darf — nichts davon wird automatisch aus der Akte übernommen." />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_input.LastArea" Label="Zuletzt gesehen (optional)" Variant="Variant.Outlined"
                              MaxLength="@PublicWantedRules.MaxLastArea" />
                @if (_options.Areas.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                        @foreach (var area in _options.Areas.Take(6))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     OnClick="@(() => _input.LastArea = area)">@area</MudChip>
                        }
                    </MudStack>
                }
            </MudItem>
            @if (_draft.Kind != PublicWantedKind.Waffe)
            {
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_input.VehicleText" Label="@VehicleLabel" Variant="Variant.Outlined"
                                  MaxLength="@PublicWantedRules.MaxVehicleText" />
                </MudItem>
            }
            @* no photo picker for an item notice: the only photo store in the house holds mugshots of the owner,
               and the service refuses a source id here rather than dropping it quietly *@
            @if (!WantedKinds.IsItem(_draft.Kind))
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_input.PhotoSourceId" Label="Foto" Clearable="true"
                               Variant="Variant.Outlined"
                               HelperText="Wird beim Veröffentlichen kopiert; ein späteres Löschen des Aktenfotos ändert den Steckbrief nicht.">
                        @foreach (var photo in _options.Photos)
                        {
                            <MudSelectItem T="string" Value="@photo.Id">Foto vom @photo.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_input.ExpiresAt" Label="Ablaufdatum (optional)" Variant="Variant.Outlined"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                @* the score only proposes: without a picker here the poster carried whatever the sweep computed,
                   and nothing in the house could correct it *@
                @* ToStringFunc, or the closed field falls back to the enum name and reads "Critical" in a German UI *@
                <MudSelect T="HazardLevel" @bind-Value="_hazard" Label="Gefahrenstufe" Variant="Variant.Outlined"
                           ToStringFunc="@(l => HazardLevelLogic.Name(l))"
                           HelperText="Steht nach außen auf dem Steckbrief. Vorbelegt aus dem Bedrohungs-Score; „Stufe aktualisieren“ setzt sie darauf zurück.">
                    @foreach (var level in HazardLevelLogic.All)
                    {
                        <MudSelectItem T="HazardLevel" Value="@level">@HazardLevelLogic.Name(level)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.subtitle2">Warnhinweise</MudText>
            @if (_mayWrite)
            {
                <MudButton OnClick="HintsAsync" Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           Disabled="_busy" StartIcon="@Icons.Material.Filled.Warning">Auswählen</MudButton>
            }
        </MudStack>
        @if (SelectedHints().Count > 0)
        {
            <WarnhinweisChips Hints="@SelectedHints()" />
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Keine Warnhinweise zugeordnet.</MudText>
        }

        <MudDivider />
        @* its own service, its own table, its own save path — never part of UpdateSnapshotAsync. No reload of this
           editor afterwards: nothing here renders bounty data, and LoadAsync would reset _input and throw away
           whatever the author has typed into the fields above but not saved yet. *@
        <BountyPanel WantedId="@_draft.Id" User="User" MayWrite="_mayWrite"
                     IsCaptured="@(_draft.Status == PublicWantedStatus.Gefasst)" />
        <MudDivider />

        <MudText Typo="Typo.subtitle2">Vorwurf</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Dieser Text ist anonym lesbar. Erwähnungen und Platzhalter werden beim Veröffentlichen abgewiesen.
        </MudText>
        @* keyed by row, and deliberately without Ai and without Mentions: public text carries no record link *@
        <RichTextEditor @ref="_editor" @key="_draft.Id" Value="@_draft.ChargeHtml" MinHeight="240px" />

        @if (!_mayWrite)
        {
            @* the read-only supervision must see what the agency publishes, it just may not be the one publishing *@
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Nur-Lese-Modus: Änderungen sind in dieser Rolle nicht möglich.
            </MudAlert>
        }
        else
        {
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       StartIcon="@Icons.Material.Filled.Save">Speichern</MudButton>

            @if (_draft.Status is PublicWantedStatus.Entwurf or PublicWantedStatus.Zurueckgezogen
                or PublicWantedStatus.Gefasst or PublicWantedStatus.Abgelaufen)
            {
                <MudButton OnClick="PublishAsync" Variant="Variant.Filled" Color="Color.Error" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Campaign">
                    @(_mayPublish ? "Veröffentlichen" : "Veröffentlichung beantragen")
                </MudButton>
            }
            @* Gefasst included: the archive row is still outside, and retracting is now its only way off it *@
            @if (_draft.Status is PublicWantedStatus.Veroeffentlicht or PublicWantedStatus.Beantragt
                or PublicWantedStatus.Gefasst)
            {
                <MudButton OnClick="RetractAsync" Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Block">Zurückziehen</MudButton>
            }
            @if (_draft.Status == PublicWantedStatus.Veroeffentlicht)
            {
                <MudButton OnClick="CapturedAsync" Variant="Variant.Outlined" Color="Color.Success" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.CheckCircle">Gefasst</MudButton>
                <MudButton OnClick="RefreshHazardAsync" Variant="Variant.Text" Color="Color.Default" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Refresh">Stufe aktualisieren</MudButton>
            }
            <MudSpacer />
            @* both outward states are retract-before-delete in the service, so neither offers the button *@
            @if (_draft.Status is not (PublicWantedStatus.Veroeffentlicht or PublicWantedStatus.Gefasst))
            {
                <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error" Disabled="_busy"
                           StartIcon="@Icons.Material.Filled.Delete">Löschen</MudButton>
            }
        </MudStack>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter, EditorRequired] public ClaimsPrincipal User { get; set; } = default!;

    /// <summary>Raised after every mutation so the hosting page can reload its own view.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    /// <summary>Raised after a delete, when there is nothing left to edit.</summary>
    [Parameter] public EventCallback Closed { get; set; }

    private PublicWantedDraft? _draft;
    private PublicWantedOptions _options = PublicWantedOptions.Empty;
    private IReadOnlyList<Warnhinweis> _hintCatalog = [];
    private List<string> _hintIds = [];
    private readonly PublicWantedInput _input = new();
    private HazardLevel _hazard = HazardLevel.No;
    private RichTextEditor? _editor;
    private bool _load = true;
    private bool _busy;
    private bool _mayPublish;
    private bool _mayWrite;
    private string? _loadedId;

    protected override void OnInitialized()
    {
        _mayPublish = User.MayHighestClassification();
        _mayWrite = User.MayWrite() && !User.IsCitizen();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }
        _loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _load = true;
        try
        {
            _draft = await Wanted.GetDraftAsync(Id, User);
            _options = await Wanted.GetOptionsAsync(Id, User);
            // all of them, not only the active ones: an assigned warning that was switched off afterwards stays
            // assigned, and the author has to see that it is there
            _hintCatalog = await Warnings.GetAllAsync();
            _hintIds = [.. await Wanted.GetHintIdsAsync(Id, User)];
            if (_draft is not null)
            {
                _input.Id = _draft.Id;
                _input.DisplayName = _draft.DisplayName;
                _input.AliasText = _draft.AliasText;
                _input.LastArea = _draft.LastArea;
                _input.VehicleText = _draft.VehicleText;
                _input.PhotoSourceId = _draft.PhotoSourceId;
                _input.ExpiresAt = _draft.ExpiresAt;
                _hazard = _draft.HazardLevel;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _draft = null;
        }
        finally
        {
            _load = false;
        }
    }

    private async Task<bool> StoreAsync()
    {
        // null would tell the service to keep the stored accusation; the editor always has the current text
        _input.ChargeHtml = _editor is null ? _draft?.ChargeHtml : await _editor.GetHtmlAsync();
        _input.HazardLevel = _hazard;
        await Wanted.UpdateSnapshotAsync(_input, User);
        return true;
    }

    private async Task SaveAsync() => await RunAsync(async () =>
    {
        await StoreAsync();
        Snackbar.Add("Ausschreibung gespeichert.", Severity.Success);
    });

    /// <summary>Every assigned warning; an inactive one is marked, because it is not on the public page.</summary>
    private List<PublicWantedHint> SelectedHints()
        => _hintCatalog
            .Where(o => _hintIds.Contains(o.Id))
            .OrderBy(o => o.SortOrder).ThenBy(o => o.Name)
            .Select(o => o.IsActive
                ? new PublicWantedHint(o.Name, o.Colour ?? string.Empty)
                : new PublicWantedHint($"{o.Name} (inaktiv, nicht öffentlich)", "Default"))
            .ToList();

    // own save path, not part of UpdateSnapshotAsync: its own table, its own audit diff
    private async Task HintsAsync() => await RunAsync(async () =>
    {
        var picked = await WarnhinweisPickerDialog.ShowAsync(DialogService, _hintIds);
        if (picked is null)
        {
            return;
        }
        await Wanted.SetHintsAsync(Id, picked, User);
        Snackbar.Add("Warnhinweise gespeichert.", Severity.Success);
    });

    private async Task PublishAsync() => await RunAsync(async () =>
    {
        string? justification = null;
        if (!_mayPublish)
        {
            justification = await ReasonDialog.ShowAsync(DialogService, "Veröffentlichung beantragen",
                "Ab Senior Special Agent wird direkt veröffentlicht; darunter entscheidet die Führung.",
                "Antrag stellen", "Begründung", mandatoryReason: true);
            if (justification is null)
            {
                return;
            }
        }
        else if (!await ConfirmDialog.ShowAsync(DialogService, "Ausschreibung veröffentlichen?",
                     "Der Steckbrief wird sofort anonym abrufbar.",
                     "Veröffentlichen", Color.Success))
        {
            return;
        }

        await StoreAsync();
        var outcome = await Wanted.PublishAsync(Id, justification, User);
        Snackbar.Add(outcome == PublicWantedPublishOutcome.Published
            ? "Ausschreibung veröffentlicht."
            : "Veröffentlichung beantragt.", Severity.Success);
    });

    private async Task RetractAsync() => await RunAsync(async () =>
    {
        var reason = await ReasonDialog.ShowAsync(DialogService, "Ausschreibung zurückziehen?",
            "Der Steckbrief ist danach nicht mehr öffentlich erreichbar.", "Zurückziehen", "Grund",
            mandatoryReason: true);
        if (reason is null)
        {
            return;
        }
        await Wanted.RetractAsync(Id, reason, User);
        Snackbar.Add("Ausschreibung zurückgezogen.", Severity.Success);
    });

    private async Task CapturedAsync() => await RunAsync(async () =>
    {
        if (!await ConfirmDialog.ShowAsync(DialogService, "Als gefasst markieren?",
                "Die Ausschreibung verschwindet damit vom öffentlichen Board.",
                "Als gefasst markieren", Color.Success))
        {
            return;
        }
        await Wanted.CapturedAsync(Id, User);
        Snackbar.Add("Als gefasst markiert.", Severity.Success);
    });

    private async Task RefreshHazardAsync() => await RunAsync(async () =>
    {
        await Wanted.RefreshHazardLevelAsync(Id, User);
        Snackbar.Add("Gefahrenstufe aktualisiert.", Severity.Success);
    });

    private async Task DeleteAsync() => await RunAsync(async () =>
    {
        if (!await ConfirmDialog.ShowAsync(DialogService, "Ausschreibung löschen?",
                "Sie landet im Papierkorb und lässt sich als Entwurf wiederherstellen."))
        {
            return;
        }
        await Wanted.DeleteAsync(Id, User);
        Snackbar.Add("Ausschreibung gelöscht.", Severity.Success);
        await Closed.InvokeAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Field labels follow the kind: a licence plate is not an "Anzeigename" to the agent typing it.</summary>
    private string NameLabel => _draft?.Kind switch
    {
        PublicWantedKind.Fahrzeug => "Kennzeichen",
        PublicWantedKind.Waffe => "Bezeichnung der Waffe",
        _ => "Anzeigename",
    };

    private string AliasLabel => _draft?.Kind switch
    {
        PublicWantedKind.Fahrzeug => "Weitere Kennzeichen (optional)",
        PublicWantedKind.Waffe => "Weitere Bezeichnungen (optional)",
        _ => "Aliase (optional)",
    };

    private string VehicleLabel => _draft?.Kind == PublicWantedKind.Fahrzeug
        ? "Modell und Farbe (optional)"
        : "Fahrzeug (optional)";

    private static Color StatusColour(PublicWantedStatus status) => status switch
    {
        PublicWantedStatus.Veroeffentlicht => Color.Error,
        PublicWantedStatus.Beantragt => Color.Warning,
        PublicWantedStatus.Gefasst => Color.Success,
        _ => Color.Default,
    };
}
