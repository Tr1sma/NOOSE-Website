@* Browser-local draft around a plain text field; the rich text editor has the same built in. All interop is guarded. *@
@inject IJSRuntime JS
@implements IAsyncDisposable

@* display:contents keeps the wrapper out of layout, so the field stays the flex or grid item it was *@
<div @ref="_wrapper" style="display:contents">@ChildContent</div>
@if (_found is { } zeit)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <MudText Typo="Typo.body2">
                Nicht gespeicherter Entwurf vom @DateTimeOffset.FromUnixTimeMilliseconds(zeit).ToLocalTime().ToString("g") gefunden.
            </MudText>
            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="RestoreAsync">Wiederherstellen</MudButton>
            <MudButton Size="Size.Small" Color="Color.Default" OnClick="DiscardAsync">Verwerfen</MudButton>
        </MudStack>
    </MudAlert>
}

@code {
    // ?v= cache-buster: bump it on every entwurf.js change, at every import site (richtext.js imports it too)
    private const string Module = "./js/entwurf.js?v=1";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Scope of the draft, e.g. "dok:neu:{personId}:grund"; null switches it off.</summary>
    /// <remarks>The agent id is put in front here, so two agents on one device never see each other's text.</remarks>
    [Parameter] public string? DraftKey { get; set; }

    /// <summary>Receives the restored text; the field decides what taking it over means.</summary>
    [Parameter] public EventCallback<string> OnRestore { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private ElementReference _wrapper;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TextDraft>? _ref;
    private string? _agentId;
    private bool _mayKeep;
    private string? _attachedKey;
    private (string Key, string Text)? _pendingBaseline;
    // DraftKey per browser handle, and the keys a draft was really written under
    private readonly Dictionary<int, string> _handleKeys = new();
    private readonly HashSet<string> _writtenKeys = new();

    /// <summary>Every <see cref="DraftKey"/> this field wrote a draft under, as the browser reported it.</summary>
    /// <remarks>
    /// For an owner whose key follows a choice made in the same form (the quick capture's record): the field can
    /// still write under the previous key for a round trip after the choice, so the owner's own idea of the key
    /// is not enough to know what to drop after saving.
    /// </remarks>
    public IReadOnlyCollection<string> WrittenKeys => _writtenKeys;
    private int _handle;
    private bool _busy;
    private bool _disposed;
    private long? _found;

    // nobody who cannot save keeps a draft: it would be offered on every visit and never go away
    private string? StoredKey => _mayKeep ? DraftKeys.Field(_agentId, DraftKey) : null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _agentId = user.GetAgentId();
            _mayKeep = user.MayContribute();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // not firstRender-only: the key may arrive later, and a recycled form may hand over another one
        var key = StoredKey;
        if (_busy || _disposed || key == _attachedKey)
        {
            return;
        }
        _busy = true; // set before the first await, or a second render attaches twice
        try
        {
            // its own method: an early return in here must not skip the release below
            await AttachAsync(key);
        }
        catch (JSDisconnectedException)
        {
            /* ignore: the next render after the reconnect tries again */
        }
        catch (Exception)
        {
            // a module that failed stays failed: give up on this key instead of retrying on every render
            _attachedKey = key;
            _pendingBaseline = null;
        }
        finally
        {
            _busy = false;
        }
        if (_disposed)
        {
            // torn down while attaching: the teardown left the release to this call, which owns the module
            await ReleaseAsync();
            return;
        }
        if (StoredKey != _attachedKey)
        {
            // the key moved on while this attach ran; the render that carried it was skipped
            StateHasChanged();
        }
    }

    private async Task AttachAsync(string? key)
    {
        await DetachAsync();
        if (key is null)
        {
            _attachedKey = null;
            _pendingBaseline = null;
            return;
        }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", Module);
        if (_disposed)
        {
            return;
        }
        _ref ??= DotNetObjectReference.Create(this);
        _handle = await _module.InvokeAsync<int>("feldAnhaengen", _wrapper, _ref, key);
        _attachedKey = key;
        if (_handle != 0 && DraftKey is { } draftKey)
        {
            _handleKeys[_handle] = draftKey;
        }
        // only a baseline meant for this key: one queued for a key that never attached belongs to another field
        if (!_disposed && _pendingBaseline is { } pending && pending.Key == key && _handle != 0)
        {
            await _module.InvokeVoidAsync("feldBasis", _handle, pending.Text);
        }
        _pendingBaseline = null;
    }

    /// <summary>Called from JS the first time a handle stored a draft.</summary>
    [JSInvokable]
    public Task OnDraftWritten(int handle)
    {
        if (_handleKeys.TryGetValue(handle, out var key))
        {
            _writtenKeys.Add(key);
        }
        return Task.CompletedTask;
    }

    /// <summary>Called from JS when a draft for this field exists, and with 0 when the offer is off again.</summary>
    [JSInvokable]
    public Task OnDraftFound(long zeit)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }
        _found = zeit > 0 ? zeit : null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RestoreAsync()
    {
        _found = null;
        if (_module is null || _handle == 0)
        {
            return;
        }
        try
        {
            if (await _module.InvokeAsync<string?>("feldEntwurf", _handle) is { } text)
            {
                await OnRestore.InvokeAsync(text);
            }
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
    }

    private async Task DiscardAsync()
    {
        _found = null;
        await CallAsync("feldVerwerfen");
    }

    /// <summary>A change made from .NET fires no input event in the browser; this saves it all the same.</summary>
    public async Task NoteChangeAsync(string text)
    {
        if (_module is null || _handle == 0)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("feldGeaendert", _handle, text);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>The owner set the field from outside (loaded, reset, template); that value is the saved state now.</summary>
    public async Task SetBaselineAsync(string text)
    {
        if (StoredKey is not { } key)
        {
            return;
        }
        if (_module is null || _handle == 0 || key != _attachedKey)
        {
            // not attached under this key yet: the attach applies it once it is
            _pendingBaseline = (key, text);
            return;
        }
        try
        {
            await _module.InvokeVoidAsync("feldBasis", _handle, text);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>Call after a successful save; the draft goes and what the field shows counts as saved.</summary>
    public async Task MarkSavedAsync()
    {
        _found = null;
        await CallAsync("feldGespeichert");
    }

    private async Task CallAsync(string function)
    {
        if (_module is null || _handle == 0)
        {
            return;
        }
        try
        {
            await _module.InvokeVoidAsync(function, _handle);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort */
        }
    }

    /// <summary>Drops one field's draft, for a caller that saves after the field is gone.</summary>
    /// <remarks>
    /// A dialog closes before its caller stores the row, and dropping the draft inside the dialog would lose it
    /// exactly when the save then fails. Call this once the write went through. Failures are swallowed.
    /// </remarks>
    public static Task DiscardAsync(IJSRuntime js, string? agentId, string? draftKey)
        => DropAsync(js, DraftKeys.Field(agentId, draftKey), null);

    /// <summary>Drops every field draft of a scope (<see cref="DraftKeys.In"/>); same rules as <see cref="DiscardAsync"/>.</summary>
    public static Task DiscardScopeAsync(IJSRuntime js, string? agentId, string? scope)
        => DropAsync(js, null, DraftKeys.Scope(agentId, scope));

    private static async Task DropAsync(IJSRuntime js, string? key, string? prefix)
    {
        if (key is null && prefix is null)
        {
            return;
        }
        try
        {
            await using var module = await js.InvokeAsync<IJSObjectReference>("import", Module);
            await module.InvokeVoidAsync("verwerfen", key, prefix);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort: a lingering draft is a nuisance, a broken save path is not */
        }
    }

    private async Task DetachAsync()
    {
        if (_module is null || _handle == 0)
        {
            return;
        }
        var handle = _handle;
        _handle = 0;
        _found = null;
        _pendingBaseline = null;
        await _module.InvokeVoidAsync("feldAbhaengen", handle);
    }

    private async Task ReleaseAsync()
    {
        try
        {
            // first call of the teardown: the pending write still has to reach the browser
            await DetachAsync();
            if (_module is not null)
            {
                await _module.DisposeAsync();
                _module = null;
            }
        }
        catch (Exception)
        {
            /* circuit already gone */
        }
        _ref?.Dispose();
        _ref = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        // an attach on its way finishes first and releases everything itself; disposing the module under it here
        // would strand its field in the browser and the references it creates after this point
        if (_busy)
        {
            return;
        }
        await ReleaseAsync();
    }
}
