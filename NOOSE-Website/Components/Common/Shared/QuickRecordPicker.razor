@* Record picker over the ordinary quick search, narrowed to the types the caller accepts. *@
@using NOOSE_Website.Services.Search
@inject ISearchService SearchService
@inject Microsoft.Extensions.Logging.ILogger<QuickRecordPicker> Logger

<MudAutocomplete T="QuickHit" Value="Value" ValueChanged="PickAsync" SearchFunc="SearchAsync"
                 ToStringFunc="@(h => h is null ? string.Empty : h.Name)"
                 Label="@Label" Placeholder="@Placeholder" HelperText="@HelperText"
                 Variant="Variant.Outlined" Disabled="Disabled" Clearable="true"
                 CoerceText="false" CoerceValue="false" ResetValueOnEmptyText="true"
                 MinCharacters="2" Immediate="true" AutoFocus="@AutoFocus"
                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search">
    <ItemTemplate Context="h">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%">
            <MudIcon Icon="@SearchCatalog.Icon(h.Category)" Size="Size.Small" Color="Color.Info" />
            <MudText Typo="Typo.body2">@h.Name</MudText>
            @if (!string.IsNullOrEmpty(h.CaseNumber))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@h.CaseNumber</MudText>
            }
            <MudSpacer />
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@SearchCatalog.German(h.Category)</MudChip>
        </MudStack>
    </ItemTemplate>
    <NoItemsTemplate>
        <MudText Typo="Typo.caption" Class="mud-text-secondary pa-2">Keine Akte gefunden.</MudText>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    /// <summary>Record types this picker offers; everything else the search returns is dropped.</summary>
    [Parameter, EditorRequired] public IReadOnlySet<string> Allowed { get; set; } = default!;

    [Parameter] public QuickHit? Value { get; set; }
    [Parameter] public EventCallback<QuickHit?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>How many hits to show at once.</summary>
    [Parameter] public int Max { get; set; } = 8;

    private ClaimsPrincipal? _user;

    protected override async Task OnInitializedAsync() => _user = (await AuthStateTask).User;

    private async Task<IEnumerable<QuickHit>> SearchAsync(string value, CancellationToken token)
    {
        var text = value?.Trim() ?? string.Empty;
        if (text.Length < 2 || _user is null)
        {
            return [];
        }
        try
        {
            // ask for more than we show: the quick search spreads its slots across every category,
            // so a request the size of the list would leave almost nothing after the filter
            var hits = await SearchService.QuickSearchAsync(text, _user, QuickCapture.FetchCount(Max, Allowed), token);
            return QuickCapture.Only(hits, Allowed, Max);
        }
        catch (Exception ex)
        {
            // a failed lookup offers nothing rather than killing the dialog
            Logger.LogDebug(ex, "Schnellsuche im Aktenwähler fehlgeschlagen.");
            return [];
        }
    }

    private Task PickAsync(QuickHit? hit) => ValueChanged.InvokeAsync(hit);
}
