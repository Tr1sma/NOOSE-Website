@* Text field with @-mention picker; inserts @{Type:Id} tokens, Ctrl+Enter submits. *@
@using System.Text.RegularExpressions
@inject IMentionService MentionService
@inject ITextImageService TextImages
@inject ITextSnippetService Snippets
@inject IPlaceholderService Placeholders
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

@* display:contents keeps the wrapper out of layout: Class="flex-grow-1" still lands on a flex item *@
<div @ref="_wrapper" style="display:contents">
<MudTextField T="string" Value="@_text" ValueChanged="OnTextChanged" Immediate="true"
              Label="@Label" Placeholder="@Placeholder" HelperText="@HelperText" Variant="Variant.Outlined"
              Lines="@Lines" MaxLength="@MaxLength" Counter="@Counter" Disabled="@Disabled" Class="@Class"
              Required="@Required" RequiredError="@RequiredError" AutoFocus="@AutoFocus"
              Adornment="@(_isPartner ? Adornment.None : Adornment.End)" AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
              OnAdornmentClick="ManualOpenAsync" AdornmentAriaLabel="Objekt verlinken"
              OnKeyDown="OnKeyDown" />
</div>

@if (_pickerOpen && _candidates.Count > 0)
{
    @* no ActiveIndex: MudTextField only offers a blanket preventDefault, so arrow keys stay with the caret *@
    <MentionPicker Candidates="_candidates" OnPick="InsertAsync" Class="mt-1" />
}

@if (_snippetOpen)
{
    @* the same list component: a second one would be these thirty lines again under another name *@
    <MentionPicker Candidates="_snippetCandidates" OnPick="InsertSnippetAsync" Class="mt-1" />
}

@if (_references.Count > 0)
{
    <MudStack Row="true" Spacing="1" Class="flex-wrap mt-1" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Verlinkt:</MudText>
        @for (var i = 0; i < _references.Count; i++)
        {
            var idx = i;
            var v = _references[i];
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(v.Hidden ? Color.Warning : Color.Primary)"
                     Icon="@MentionVisuals.Symbol(v.Type)" OnClose="@(() => RemoveTokenAsync(idx))">@v.Text</MudChip>
        }
    </MudStack>
}

@code {
    @* a literal @ can't sit in a Razor attribute, so callers bind this instead *@
    /// <summary>Discovery hint for helper texts; the @-picker is otherwise easy to miss.</summary>
    public const string Hint = "Verlinken per @.";

    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Raised on Ctrl+Enter.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public int Lines { get; set; } = 2;
    [Parameter] public int MaxLength { get; set; } = 524288;
    [Parameter] public int? Counter { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Record type an image pasted into this field belongs to; null keeps image paste off.</summary>
    /// <remarks>
    /// Opt-in like the @-picker: the pair below decides who may later see the picture, so a field that cannot name
    /// its carrying record must not accept one. A single-line reason field is also simply the wrong place for it.
    /// </remarks>
    [Parameter] public string? ImageOwnerType { get; set; }

    /// <summary>Record id the pasted image belongs to; see <see cref="ImageOwnerType"/>.</summary>
    [Parameter] public string? ImageOwnerId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string? _meId;
    private bool _isPartner;
    private bool _mayClassifiedRead;
    private bool _mayRealName;
    private bool _mayWrite;
    private ClaimsPrincipal? _user;

    private ElementReference _wrapper;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MentionInput>? _ref;
    private bool _disposed;
    private bool _attaching;

    // the read-only supervision would only run into the service guard, and a partner posts plain text
    private bool ImagePasteEnabled =>
        !string.IsNullOrWhiteSpace(ImageOwnerType) && !string.IsNullOrWhiteSpace(ImageOwnerId)
        && _mayWrite && !_isPartner;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _user = user;
            _mayWrite = user.MayWrite();
            _meId = user.GetAgentId();
            // partners post plain text: the @-picker is unscoped, so it stays disabled for them
            _isPartner = user.IsPartner();
            _mayClassifiedRead = user.MayClassifiedRead();
            _mayRealName = user.MayRealNameSee();
        }
    }

    private string _text = string.Empty;
    private bool _pickerOpen;
    private List<MentionHit> _candidates = new();
    private List<MentionSegment> _references = new();
    private string _referenceSignature = string.Empty;

    private static readonly Regex ActiveQuery = new(@"@([^\s@{}]*)$", RegexOptions.Compiled);

    private List<TextSnippet>? _snippets;
    private List<MentionHit> _snippetCandidates = new();
    private bool _snippetOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (_text != (Text ?? string.Empty))
        {
            _text = Text ?? string.Empty;
            await ReferencesRefreshAsync();
        }
    }

    private async Task OnTextChanged(string? @new)
    {
        _text = @new ?? string.Empty;
        await TextChanged.InvokeAsync(_text);
        await PickerRefreshAsync();
        await SnippetRefreshAsync();
        await ReferencesRefreshAsync();
    }

    private async Task PickerRefreshAsync()
    {
        if (_isPartner)
        {
            return; // no unscoped record picker for partners
        }
        var m = ActiveQuery.Match(_text);
        if (!m.Success || m.Groups[1].Value.Length < 1)
        {
            ClosePicker();
            return;
        }
        if (AuthStateTask is null)
        {
            return;
        }
        _candidates = await MentionService.CandidatesAsync(m.Groups[1].Value, (await AuthStateTask).User);
        _pickerOpen = _candidates.Count > 0;
    }

    private void ClosePicker()
    {
        _pickerOpen = false;
        _candidates = new();
    }

    private void CloseSnippets()
    {
        _snippetOpen = false;
        _snippetCandidates = new();
    }

    private async Task SnippetRefreshAsync()
    {
        if (SnippetTrigger.Query(_text) is not { Length: > 0 } query || AuthStateTask is null)
        {
            CloseSnippets();
            return;
        }

        // loaded once per field: a handful of rows that only ever change in the profile, and a query per
        // keystroke would put the database on the typing path
        _snippets ??= await Snippets.GetMineAsync((await AuthStateTask).User);
        _snippetCandidates = _snippets
            .Where(s => s.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .Select(s => new MentionHit(nameof(TextSnippet), s.Id, s.Name, SnippetTrigger.Preview(s.Text)))
            .ToList();
        _snippetOpen = _snippetCandidates.Count > 0;
    }

    private async Task InsertSnippetAsync(MentionHit hit)
    {
        var snippet = _snippets?.FirstOrDefault(s => s.Id == hit.Id);
        if (snippet is null || AuthStateTask is null)
        {
            CloseSnippets();
            return;
        }

        // placeholders resolve against the record this field already names for the picture paste
        var body = await Placeholders.ApplyPlainAsync(
            snippet.Text, ImageOwnerType, ImageOwnerId, (await AuthStateTask).User);
        _text = SnippetTrigger.Insert(_text, body, MaxLength);
        CloseSnippets();
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
    }


    private async Task InsertAsync(MentionHit k)
    {
        var m = ActiveQuery.Match(_text);
        // replace active query with token, else append
        _text = m.Success
            ? string.Concat(_text.AsSpan(0, m.Index), MentionParser.Token(k.Type, k.Id), " ")
            : _text + MentionParser.Token(k.Type, k.Id) + " ";
        ClosePicker();
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
    }

    private async Task RemoveTokenAsync(int index)
    {
        var tokens = MentionParser.Parse(_text);
        if (index < 0 || index >= tokens.Count)
        {
            return;
        }
        var t = tokens[index];
        _text = _text.Remove(t.Start, t.Length);
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
    }

    private async Task ReferencesRefreshAsync()
    {
        if (_isPartner)
        {
            return; // partners can't insert tokens, so nothing to resolve/preview
        }
        // only re-resolve when the token set changed
        var sig = string.Join(",", MentionParser.Parse(_text).Select(t => $"{t.Type}:{t.Id}"));
        if (sig == _referenceSignature)
        {
            return;
        }
        _referenceSignature = sig;
        if (string.IsNullOrEmpty(sig))
        {
            _references = new();
            return;
        }
        var segments = await MentionService.ResolveAsync(_text, _mayClassifiedRead, _meId);
        _references = segments.Where(s => s.IsReference).ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && (_pickerOpen || _snippetOpen))
        {
            ClosePicker();
            CloseSnippets();
            return;
        }
        if (e.Key == "Enter" && e.CtrlKey)
        {
            ClosePicker();
            CloseSnippets();
            await OnSubmit.InvokeAsync();
        }
    }

    private async Task ManualOpenAsync()
    {
        var separator = _text.Length > 0 && !_text.EndsWith(" ") && !_text.EndsWith("\n") ? " " : string.Empty;
        _text = $"{_text}{separator}@";
        await TextChanged.InvokeAsync(_text);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // not firstRender-only: the auth state may still be pending then, which would leave the module unattached
        if (!ImagePasteEnabled || _attaching || _disposed)
        {
            return;
        }
        _attaching = true; // set before the first await, or a second render imports the module twice
        try
        {
            // ?v= cache-buster: bump it on every textbild.js change (dynamic imports bypass asset fingerprinting)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/textbild.js?v=1");
            _ref = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _wrapper, _ref);
        }
        catch (JSDisconnectedException)
        {
            /* ignore */
        }
        catch (Exception)
        {
            /* best effort: without the module Ctrl+V simply pastes text */
        }
    }

    /// <summary>Stores the pasted bitmap and drops its token where the caret was.</summary>
    [JSInvokable]
    public async Task OnImagePastedAsync(string base64, string contentType, int caret)
    {
        if (!ImagePasteEnabled || _user is null)
        {
            return;
        }
        byte[] bytes;
        try
        {
            bytes = Convert.FromBase64String(base64);
        }
        catch (FormatException)
        {
            return;
        }

        string? token;
        try
        {
            token = await TextImages.SaveAsync(ImageOwnerType!, ImageOwnerId!, bytes, contentType, _user);
        }
        catch (UnauthorizedAccessException)
        {
            token = null;
        }
        if (token is null)
        {
            Snackbar.Add("Bild konnte nicht eingefügt werden.", Severity.Warning);
            return;
        }

        // the caret sat in the pre-paste text, so it still indexes it; -1 means the field never reported one
        var at = caret >= 0 && caret <= _text.Length ? caret : _text.Length;
        _text = _text.Insert(at, token + " ");
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
        StateHasChanged();
    }

    /// <summary>Reported by the module instead of marshalling megabytes that would be rejected anyway.</summary>
    [JSInvokable]
    public void OnImageTooLarge()
        => Snackbar.Add("Das Bild ist zu groß (max. 8 MB).", Severity.Warning);

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach", _wrapper);
                await _module.DisposeAsync();
            }
        }
        catch (Exception)
        {
            /* circuit already gone */
        }
        _ref?.Dispose();
    }
}
