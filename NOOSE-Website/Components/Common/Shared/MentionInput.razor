@* Text field with @-mention picker; inserts @{Type:Id} tokens, Ctrl+Enter submits. *@
@using System.Text.RegularExpressions
@inject IMentionService MentionService

<MudTextField T="string" Value="@_text" ValueChanged="OnTextChanged" Immediate="true"
              Label="@Label" Placeholder="@Placeholder" HelperText="@HelperText" Variant="Variant.Outlined"
              Lines="@Lines" MaxLength="@MaxLength" Counter="@Counter" Disabled="@Disabled" Class="@Class"
              Required="@Required" RequiredError="@RequiredError" AutoFocus="@AutoFocus"
              Adornment="@(_isPartner ? Adornment.None : Adornment.End)" AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
              OnAdornmentClick="ManualOpenAsync" AdornmentAriaLabel="Objekt verlinken"
              OnKeyDown="OnKeyDown" />

@if (_pickerOpen && _candidates.Count > 0)
{
    @* no ActiveIndex: MudTextField only offers a blanket preventDefault, so arrow keys stay with the caret *@
    <MentionPicker Candidates="_candidates" OnPick="InsertAsync" Class="mt-1" />
}

@if (_references.Count > 0)
{
    <MudStack Row="true" Spacing="1" Class="flex-wrap mt-1" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Verlinkt:</MudText>
        @for (var i = 0; i < _references.Count; i++)
        {
            var idx = i;
            var v = _references[i];
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(v.Hidden ? Color.Warning : Color.Primary)"
                     Icon="@MentionVisuals.Symbol(v.Type)" OnClose="@(() => RemoveTokenAsync(idx))">@v.Text</MudChip>
        }
    </MudStack>
}

@code {
    @* a literal @ can't sit in a Razor attribute, so callers bind this instead *@
    /// <summary>Discovery hint for helper texts; the @-picker is otherwise easy to miss.</summary>
    public const string Hint = "Verlinken per @.";

    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Raised on Ctrl+Enter.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public int Lines { get; set; } = 2;
    [Parameter] public int MaxLength { get; set; } = 524288;
    [Parameter] public int? Counter { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? RequiredError { get; set; }
    [Parameter] public bool AutoFocus { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string? _meId;
    private bool _isPartner;
    private bool _mayClassifiedRead;
    private bool _mayRealName;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            _meId = user.GetAgentId();
            // partners post plain text: the @-picker is unscoped, so it stays disabled for them
            _isPartner = user.IsPartner();
            _mayClassifiedRead = user.MayClassifiedRead();
            _mayRealName = user.MayRealNameSee();
        }
    }

    private string _text = string.Empty;
    private bool _pickerOpen;
    private List<MentionHit> _candidates = new();
    private List<MentionSegment> _references = new();
    private string _referenceSignature = string.Empty;

    private static readonly Regex ActiveQuery = new(@"@([^\s@{}]*)$", RegexOptions.Compiled);

    protected override async Task OnParametersSetAsync()
    {
        if (_text != (Text ?? string.Empty))
        {
            _text = Text ?? string.Empty;
            await ReferencesRefreshAsync();
        }
    }

    private async Task OnTextChanged(string? @new)
    {
        _text = @new ?? string.Empty;
        await TextChanged.InvokeAsync(_text);
        await PickerRefreshAsync();
        await ReferencesRefreshAsync();
    }

    private async Task PickerRefreshAsync()
    {
        if (_isPartner)
        {
            return; // no unscoped record picker for partners
        }
        var m = ActiveQuery.Match(_text);
        if (!m.Success || m.Groups[1].Value.Length < 1)
        {
            ClosePicker();
            return;
        }
        if (AuthStateTask is null)
        {
            return;
        }
        _candidates = await MentionService.CandidatesAsync(m.Groups[1].Value, (await AuthStateTask).User);
        _pickerOpen = _candidates.Count > 0;
    }

    private void ClosePicker()
    {
        _pickerOpen = false;
        _candidates = new();
    }

    private async Task InsertAsync(MentionHit k)
    {
        var m = ActiveQuery.Match(_text);
        // replace active query with token, else append
        _text = m.Success
            ? string.Concat(_text.AsSpan(0, m.Index), MentionParser.Token(k.Type, k.Id), " ")
            : _text + MentionParser.Token(k.Type, k.Id) + " ";
        ClosePicker();
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
    }

    private async Task RemoveTokenAsync(int index)
    {
        var tokens = MentionParser.Parse(_text);
        if (index < 0 || index >= tokens.Count)
        {
            return;
        }
        var t = tokens[index];
        _text = _text.Remove(t.Start, t.Length);
        await TextChanged.InvokeAsync(_text);
        await ReferencesRefreshAsync();
    }

    private async Task ReferencesRefreshAsync()
    {
        if (_isPartner)
        {
            return; // partners can't insert tokens, so nothing to resolve/preview
        }
        // only re-resolve when the token set changed
        var sig = string.Join(",", MentionParser.Parse(_text).Select(t => $"{t.Type}:{t.Id}"));
        if (sig == _referenceSignature)
        {
            return;
        }
        _referenceSignature = sig;
        if (string.IsNullOrEmpty(sig))
        {
            _references = new();
            return;
        }
        var segments = await MentionService.ResolveAsync(_text, _mayClassifiedRead, _meId);
        _references = segments.Where(s => s.IsReference).ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _pickerOpen)
        {
            ClosePicker();
            return;
        }
        if (e.Key == "Enter" && e.CtrlKey)
        {
            ClosePicker();
            await OnSubmit.InvokeAsync();
        }
    }

    private async Task ManualOpenAsync()
    {
        var separator = _text.Length > 0 && !_text.EndsWith(" ") && !_text.EndsWith("\n") ? " " : string.Empty;
        _text = $"{_text}{separator}@";
        await TextChanged.InvokeAsync(_text);
    }

}
