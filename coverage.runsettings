<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Code Coverage settings. Coverlet is not used: its Mono.Cecil build cannot
     instrument .NET 10 assemblies. Run:
       dotnet test NOOSE-Website.Tests --collect "Code Coverage" --settings coverage.runsettings
     then narrow to the target namespaces with NOOSE-Website.Tests/coverage/coverage-summary.py. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <Format>Cobertura</Format>
            <ModulePaths>
              <Include>
                <ModulePath>.*NOOSE-Website\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
            <!-- Classes marked [ExcludeFromCodeCoverage] (DI wiring, network client, demo-data
                 fixtures) are dropped automatically. -->
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
